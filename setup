#!/usr/bin/env bash
# gstack-extend setup — install each skill as its own SKILL.md directory.
#
# Usage:
#   ./setup                                          # Claude (~/.claude/skills/)
#   ./setup --host auto                              # detect claude/codex/opencode/cursor
#   ./setup --host claude|codex|opencode|cursor
#   ./setup --host <host> --uninstall
#   ./setup --skills-dir <path> --uninstall          # legacy v0.16.0 cleanup
#   ./setup --quiet
set -euo pipefail

if ! command -v bun >/dev/null 2>&1; then
  echo "Error: bun is required but not installed." >&2
  echo "Install with checksum verification:" >&2
  echo '  BUN_VERSION="1.3.10"' >&2
  echo '  tmpfile=$(mktemp)' >&2
  echo '  curl -fsSL "https://bun.sh/install" -o "$tmpfile"' >&2
  echo '  echo "Verify checksum before running: shasum -a 256 $tmpfile"' >&2
  echo '  BUN_VERSION="$BUN_VERSION" bash "$tmpfile" && rm "$tmpfile"' >&2
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
SKILLS_DIR=""
SKILLS_DIR_GIVEN=0
UNINSTALL=0
QUIET=0
HOST="claude"
USAGE="Usage: ./setup [--host claude|codex|opencode|cursor|auto] [--uninstall] [--quiet] [--skills-dir <path> --uninstall]"

# shellcheck source=bin/lib/install-safety.sh
. "$SCRIPT_DIR/bin/lib/install-safety.sh"

log() { [ "$QUIET" -eq 0 ] && echo "$@" || true; }

# Protocol output survives --quiet and failures after a host was skipped.
SKIPPED_HOSTS=""
SKIPPED_NON_CURSOR=0
skip_host() {
  case "$1" in
    claude) INSTALL_CLAUDE=0 ;;
    codex) INSTALL_CODEX=0 ;;
    opencode) INSTALL_OPENCODE=0 ;;
    cursor) INSTALL_CURSOR=0 ;;
  esac
  [ "$1" = "cursor" ] || SKIPPED_NON_CURSOR=1
  SKIPPED_HOSTS="${SKIPPED_HOSTS:+$SKIPPED_HOSTS,}$1"
}
report_skipped_hosts() {
  [ -z "$SKIPPED_HOSTS" ] || printf 'SETUP_SKIPPED_HOSTS %s\n' "$SKIPPED_HOSTS"
  return 0
}
REWRITE_TMP=""
on_exit() {
  [ -z "$REWRITE_TMP" ] || rm -f "$REWRITE_TMP"
  report_skipped_hosts
}
trap on_exit EXIT

while [ $# -gt 0 ]; do
  case "$1" in
    --uninstall)
      UNINSTALL=1
      shift
      ;;
    -q|--quiet)
      QUIET=1
      shift
      ;;
    --host)
      if [ -z "${2:-}" ] || [ "${2#-}" != "$2" ]; then
        echo "Error: --host requires claude, codex, opencode, cursor, or auto (got: '${2:-<missing>}')" >&2
        echo "$USAGE" >&2
        exit 1
      fi
      HOST="$2"
      shift 2
      ;;
    --host=*)
      HOST="${1#--host=}"
      shift
      ;;
    --skills-dir)
      if [ -z "${2:-}" ] || [ "${2#-}" != "$2" ]; then
        echo "Error: --skills-dir requires a path argument (got: '${2:-<missing>}')" >&2
        echo "$USAGE" >&2
        exit 1
      fi
      if [ "${2#/}" = "$2" ]; then
        echo "Error: --skills-dir requires an absolute path (got: '$2')" >&2
        echo "Hint: use \$(pwd)/$2 if you meant the current directory." >&2
        echo "$USAGE" >&2
        exit 1
      fi
      SKILLS_DIR="$2"
      SKILLS_DIR_GIVEN=1
      shift 2
      ;;
    *)
      echo "Unknown option: $1" >&2
      echo "$USAGE" >&2
      exit 1
      ;;
  esac
done

case "$HOST" in
  claude|codex|opencode|cursor|auto) ;;
  *)
    echo "Unknown --host value: $HOST (expected claude, codex, opencode, cursor, or auto)" >&2
    echo "$USAGE" >&2
    exit 1
    ;;
esac

if [ "$SKILLS_DIR_GIVEN" -eq 1 ] && [ "$UNINSTALL" -eq 0 ]; then
  echo "Error: --skills-dir is no longer accepted for install." >&2
  echo "  Skill preambles probe host skill dirs (~/.claude, ~/.codex, ~/.config/opencode, ~/.cursor)." >&2
  echo "  Symlinks at any other path will not be discovered." >&2
  echo "" >&2
  echo "  To clean up a v0.16.0-era custom install, use:" >&2
  echo "    ./setup --skills-dir <old-path> --uninstall" >&2
  echo "" >&2
  echo "$USAGE" >&2
  exit 1
fi

SKILLS=(
  pair-review
  roadmap
  full-review
  gstack-extend-upgrade
  gstack-extend-init
  review-and-prep
  implement
  ship-and-land
)

LEGACY_SKILLS=(
  review-apparatus
  test-plan
  browse-native
  roadmap-new
)

host_skills_dir() {
  case "$1" in
    claude) echo "${HOME}/.claude/skills" ;;
    codex) echo "${HOME}/.codex/skills" ;;
    opencode) echo "${HOME}/.config/opencode/skills" ;;
    cursor) echo "${HOME}/.cursor/skills" ;;
    *) echo "" ;;
  esac
}

# Never treat the package checkout as a skill (no root SKILL.md).
refuse_package_root_link() {
  local dest="$1"
  if [ -L "$dest" ]; then
    local dest_target
    dest_target="$(readlink "$dest" 2>/dev/null || true)"
    if [ "$dest_target" = "$SCRIPT_DIR" ]; then
      rm -f "$dest"
      log "Removed package-root skill link: $dest"
    fi
  fi
}

# Keep shell paths as authored. Baking HOME into bash bodies changes parsing
# when it contains spaces or shell metacharacters; the skill resolver probes hosts.
host_skill_body() {
  local src="$1" host="$2"
  if [ "$host" = "codex" ] || [ "$host" = "cursor" ]; then
    awk '
      BEGIN { fm=0; skip=0 }
      /^---[[:space:]]*$/ {
        if (fm==0) { fm=1; print; next }
        skip=0; print; next
      }
      fm==1 && /^allowed-tools:[[:space:]]*$/ { skip=1; next }
      skip==1 && /^[[:space:]]+-[[:space:]]/ { next }
      skip==1 { skip=0 }
      { print }
    ' "$src"
  else
    cat "$src"
  fi
}

rewrite_skill_body() {
  local src="$1"
  local dest="$2"
  local host="$3"
  local tmp

  if [ -L "$dest" ]; then
    rm -f "$dest"
  fi

  # Write beside dest, then rename over it: never truncate or write through the existing file (a hardlink to the
  # source, say), and readers never see a partial copy. mktemp's 0600 becomes the umask's default file mode. The
  # EXIT trap removes the temp file if setup dies or is interrupted before the rename.
  tmp="$(mktemp "$(dirname "$dest")/.SKILL.md.XXXXXX")"
  REWRITE_TMP="$tmp"
  if chmod "$(printf '%o' $(( 0666 & ~$(umask) )))" "$tmp" && host_skill_body "$src" "$host" > "$tmp" &&
    mv -f "$tmp" "$dest"; then
    REWRITE_TMP=""
    return 0
  fi
  rm -f "$tmp"
  REWRITE_TMP=""
  return 1
}

# A regular-file SKILL.md next to an .extend-root pointer is a copy setup generated for Codex/OpenCode/Cursor. Claude
# installs are symlinks, so there the pointer must never make a user's detached, customized SKILL.md look generated.
# Only those three hosts qualify; a host-agnostic caller (the legacy --skills-dir cleanup, which targets v0.16.0
# symlink installs) never removes or overwrites a regular file.
generated_copy() {
  local target="$1" host="${2:-}"
  case "$host" in codex|opencode|cursor) ;; *) return 1 ;; esac
  [ -f "$target/SKILL.md" ] && [ ! -L "$target/SKILL.md" ] && [ -f "$target/.extend-root" ]
}

# Collapse "." and ".." in an absolute path. The path does not need to exist, so a
# deleted checkout still compares equal to the absolute pointer setup wrote.
lex_abs() {
  local input="$1" part out="" item
  local -a stack=()
  case "$input" in
    /*) ;;
    *) printf '%s\n' "$input"; return ;;
  esac
  input="${input#/}"
  while [ -n "$input" ]; do
    part="${input%%/*}"
    case "$input" in
      */*) input="${input#*/}" ;;
      *) input="" ;;
    esac
    case "$part" in
      ''|.) ;;
      ..)
        if [ "${#stack[@]}" -gt 0 ]; then
          unset "stack[$((${#stack[@]} - 1))]"
        fi
        ;;
      *) stack[${#stack[@]}]="$part" ;;
    esac
  done
  for item in "${stack[@]}"; do
    out="$out/$item"
  done
  printf '%s\n' "${out:-/}"
}

# A SKILL.md symlink is setup's when it targets <checkout>/skills/<skill>.md in this checkout or another gstack-extend
# checkout (a worktree or an older clone), or in a checkout that no longer exists but that setup's own .extend-root
# beside the link still names. Any other link (a dotfiles-managed personal skill, say) is user-owned and treated like
# a user's regular file.
extend_owned_link() {
  local link="$1" skill="$2" target root pointer=""
  target="$(readlink "$link" 2>/dev/null || true)"
  case "$target" in */skills/"$skill".md) ;; *) return 1 ;; esac
  case "$target" in /*) ;; *) target="$(dirname "$link")/$target" ;; esac
  root="$(lex_abs "${target%/skills/"$skill".md}")"
  if [ -e "$root" ]; then
    [ -f "$root/setup" ] && [ -f "$root/bin/update-check" ]
  else
    [ -f "$(dirname "$link")/.extend-root" ] || return 1
    IFS= read -r pointer < "$(dirname "$link")/.extend-root" || true
    [ "$(lex_abs "$pointer")" = "$root" ]
  fi
}

link_target() {
  local target
  target="$(readlink "$1")"
  case "$target" in
    /*) printf '%s\n' "$target" ;;
    *) printf '%s\n' "$(dirname "$1")/$target" ;;
  esac
}

# Two skills dirs are the same when their deepest existing ancestors are the same directory (compared by inode, so
# case variants on a case-insensitive disk match) and the missing parts below them are spelled the same. A dangling
# link is followed to its target, so a link into a directory that does not exist yet compares by where it leads.
same_skills_dir() {
  local a="$1" b="$2" rest_a="" rest_b="" hops=0
  while [ ! -d "$a" ]; do
    if [ -L "$a" ] && [ "$hops" -lt 40 ]; then a="$(link_target "$a")"; hops=$((hops + 1)); continue; fi
    rest_a="/$(basename "$a")$rest_a"; a="$(dirname "$a")"
  done
  hops=0
  while [ ! -d "$b" ]; do
    if [ -L "$b" ] && [ "$hops" -lt 40 ]; then b="$(link_target "$b")"; hops=$((hops + 1)); continue; fi
    rest_b="/$(basename "$b")$rest_b"; b="$(dirname "$b")"
  done
  # Missing components cannot be links, so collapse "." and ".." lexically; ignore case, since a case variant may
  # name the same directory once it exists (a false match only skips a host).
  rest_a="$(lex_abs "${rest_a:-/}" | tr '[:upper:]' '[:lower:]')"
  rest_b="$(lex_abs "${rest_b:-/}" | tr '[:upper:]' '[:lower:]')"
  [ "$rest_a" = "$rest_b" ] && [ "$a" -ef "$b" ]
}

# Shared CLI links belong to this checkout until its last host install is gone: a pointer naming it beside a
# SKILL.md. Scan all installed names, including retired or user-detached skills; a pointer left without a SKILL.md
# is not an install. Sets HOST_INSTALL_POINTER to the first pointer found so the caller can name it.
HOST_INSTALL_POINTER=""
checkout_has_host_install() {
  local host pointer root link
  for host in claude codex opencode cursor; do
    for pointer in "$(host_skills_dir "$host")"/*/.extend-root; do
      [ -f "$pointer" ] && [ -r "$pointer" ] || continue
      [ -e "${pointer%/.extend-root}/SKILL.md" ] || [ -L "${pointer%/.extend-root}/SKILL.md" ] || continue
      root=""
      IFS= read -r root < "$pointer" || true
      if [ "$(lex_abs "$root")" = "$SCRIPT_DIR" ]; then
        HOST_INSTALL_POINTER="$pointer"
        return 0
      fi
    done
  done
  # Claude installs from before every host got a pointer are bare SKILL.md links into this checkout.
  for link in "$(host_skills_dir claude)"/*/SKILL.md; do
    [ -L "$link" ] || continue
    if [ "$(lex_abs "$(link_target "$link")")" = "$SCRIPT_DIR/skills/$(basename "$(dirname "$link")").md" ]; then
      HOST_INSTALL_POINTER="$link"
      return 0
    fi
  done
  return 1
}

uninstall_from_dir() {
  local skills_dir="$1"
  local host="${2:-}"
  local names=("${SKILLS[@]}" "${LEGACY_SKILLS[@]}")
  if [ "${3:-}" = "legacy" ]; then
    names=("${LEGACY_SKILLS[@]}")
  fi
  local skill target link_target expected
  for skill in "${names[@]}"; do
    target="$skills_dir/$skill"
    if [ -e "$target" ] || [ -L "$target" ]; then
      if [ -L "$target" ]; then
        log "Skipped $skill (target is a symlink — refusing to operate on it)"
        continue
      fi
      if [ ! -d "$target" ]; then
        log "Skipped $skill (target exists but is not a directory)"
        continue
      fi
    else
      continue
    fi
    if [ -L "$target/SKILL.md" ]; then
      link_target="$(readlink "$target/SKILL.md" 2>/dev/null || true)"
      case "$link_target" in
        /*) ;;
        *) link_target="$(dirname "$target/SKILL.md")/$link_target" ;;
      esac
      expected="$SCRIPT_DIR/skills/${skill}.md"
      if [ "$(lex_abs "$link_target")" = "$(lex_abs "$expected")" ]; then
        rm -f "$target/SKILL.md"
        rm -f "$target/.extend-root"
        rmdir "$target" 2>/dev/null || true
        log "Removed $skill"
      else
        log "Skipped $skill (symlink points elsewhere)"
      fi
    elif generated_copy "$target" "$host"; then
      local baked
      baked="$(cat "$target/.extend-root" 2>/dev/null || true)"
      if [ "$baked" = "$SCRIPT_DIR" ]; then
        rm -f "$target/SKILL.md" "$target/.extend-root"
        rmdir "$target" 2>/dev/null || true
        log "Removed $skill"
      else
        log "Skipped $skill (extend-root points elsewhere)"
      fi
    fi
  done
  refuse_package_root_link "$skills_dir/gstack-extend"
}

preflight_dir() {
  local skills_dir="$1"
  local host="$2"
  if ! is_safe_install_path "$skills_dir"; then
    echo "$USAGE" >&2
    exit 1
  fi
  local skill target src
  for skill in "${SKILLS[@]}"; do
    target="$skills_dir/$skill"
    src="$SCRIPT_DIR/skills/${skill}.md"
    if [ ! -f "$src" ]; then
      echo "Warning: $src not found, skipping" >&2
      continue
    fi
    if ! is_safe_target_path "$target"; then
      echo "$USAGE" >&2
      exit 1
    fi
    if [ -e "$target/.extend-root" ] && [ ! -f "$target/.extend-root" ]; then
      echo "Warning: $target/.extend-root is not a regular file, not overwriting" >&2
      continue
    fi
    if [ -e "$target/SKILL.md" ] && [ ! -f "$target/SKILL.md" ] && [ ! -L "$target/SKILL.md" ]; then
      echo "Warning: $target/SKILL.md is not a regular file, not overwriting" >&2
      continue
    fi
    if [ -f "$target/SKILL.md" ] && [ ! -L "$target/SKILL.md" ] && ! generated_copy "$target" "$host"; then
      echo "Warning: $target/SKILL.md is a regular file, not overwriting" >&2
      continue
    fi
    if [ -L "$target/SKILL.md" ] && ! extend_owned_link "$target/SKILL.md" "$skill"; then
      if [ -e "$target/SKILL.md" ]; then
        echo "Warning: $target/SKILL.md links outside a gstack-extend checkout, not overwriting" >&2
      else
        echo "Warning: $target/SKILL.md links to a missing file, not overwriting." >&2
        echo "  If it was a gstack-extend install from a moved checkout, remove the link and re-run setup." >&2
      fi
      continue
    fi
  done
}

install_into_dir() {
  local skills_dir="$1"
  local host="$2"
  local skill src target installed
  installed=0
  mkdir -p "$skills_dir"
  refuse_package_root_link "$skills_dir/gstack-extend"
  uninstall_from_dir "$skills_dir" "$host" legacy

  for skill in "${SKILLS[@]}"; do
    src="$SCRIPT_DIR/skills/${skill}.md"
    [ -f "$src" ] || continue
    target="$skills_dir/$skill"
    if [ -e "$target/.extend-root" ] && [ ! -f "$target/.extend-root" ]; then
      continue
    fi
    if [ -e "$target/SKILL.md" ] && [ ! -f "$target/SKILL.md" ] && [ ! -L "$target/SKILL.md" ]; then
      continue
    fi
    if [ -f "$target/SKILL.md" ] && [ ! -L "$target/SKILL.md" ] && ! generated_copy "$target" "$host"; then
      continue
    fi
    if [ -L "$target/SKILL.md" ] && ! extend_owned_link "$target/SKILL.md" "$skill"; then
      continue
    fi
    mkdir -p "$target"
    if [ "$host" = "claude" ]; then
      ln -snf "$src" "$target/SKILL.md"
    else
      rewrite_skill_body "$src" "$target/SKILL.md" "$host"
    fi
    # Every host gets the pointer: the telemetry blocks fall back to it when the wrapper is not on PATH,
    # which matters for a Claude install from a clone outside ~/.claude/skills/gstack-extend.
    rm -f "$target/.extend-root"
    printf '%s\n' "$SCRIPT_DIR" > "$target/.extend-root"
    installed=$((installed + 1))
  done
  log "Installed $installed skills into $skills_dir"
}

# ─── Resolve which hosts to touch ──────────────────────────────────
INSTALL_CLAUDE=0
INSTALL_CODEX=0
INSTALL_OPENCODE=0
INSTALL_CURSOR=0

if [ "$SKILLS_DIR_GIVEN" -eq 1 ]; then
  :
elif [ "$HOST" = "auto" ]; then
  command -v claude >/dev/null 2>&1 && INSTALL_CLAUDE=1
  command -v codex >/dev/null 2>&1 && INSTALL_CODEX=1
  command -v opencode >/dev/null 2>&1 && INSTALL_OPENCODE=1
  command -v cursor >/dev/null 2>&1 && INSTALL_CURSOR=1
  [ -d "${HOME}/.cursor" ] && INSTALL_CURSOR=1
  [ -e "${HOME}/.claude/skills/pair-review/SKILL.md" ] && INSTALL_CLAUDE=1
  [ -e "${HOME}/.codex/skills/pair-review/SKILL.md" ] && INSTALL_CODEX=1
  [ -e "${HOME}/.config/opencode/skills/pair-review/SKILL.md" ] && INSTALL_OPENCODE=1
  [ -e "${HOME}/.cursor/skills/pair-review/SKILL.md" ] && INSTALL_CURSOR=1
elif [ "$HOST" = "claude" ]; then
  INSTALL_CLAUDE=1
elif [ "$HOST" = "codex" ]; then
  INSTALL_CODEX=1
elif [ "$HOST" = "opencode" ]; then
  INSTALL_OPENCODE=1
elif [ "$HOST" = "cursor" ]; then
  INSTALL_CURSOR=1
fi

# A copy-producing pass must never rewrite or remove another host's directory, even if that other host was not
# selected. Codex and OpenCode skip a directory shared with Claude or with each other; they need separate dirs.
# Cursor yields to any host whose directory it shares, as it always has, and reads that host's install there.
CURSOR_OWNER=""
for _host in codex opencode cursor; do
  case "$_host" in
    codex) [ "$INSTALL_CODEX" -eq 1 ] || continue ;;
    opencode) [ "$INSTALL_OPENCODE" -eq 1 ] || continue ;;
    cursor) [ "$INSTALL_CURSOR" -eq 1 ] || continue ;;
  esac
  for _other in claude codex opencode cursor; do
    case "$_other" in "$_host"|cursor) continue ;; esac
    if same_skills_dir "$(host_skills_dir "$_host")" "$(host_skills_dir "$_other")"; then
      echo "Warning: $(host_skills_dir "$_host") is the $_other skills directory; skipping $_host" >&2
      if [ "$_host" = "cursor" ]; then
        INSTALL_CURSOR=0
        CURSOR_OWNER="$_other"
      else
        echo "  Use separate host skills directories. For legacy copies, see docs/installation.md: Shared-directory migration." >&2
        skip_host "$_host"
      fi
      break
    fi
  done
done

any_host_selected() {
  [ "$INSTALL_CLAUDE" -eq 1 ] || [ "$INSTALL_CODEX" -eq 1 ] || [ "$INSTALL_OPENCODE" -eq 1 ] || [ "$INSTALL_CURSOR" -eq 1 ]
}

# A Cursor that yielded is served when this run also processes the host it yielded to; otherwise report it.
# Call once host selection is final.
report_unserved_cursor() {
  local served=0
  case "$CURSOR_OWNER" in
    '') return 0 ;;
    claude) served=$INSTALL_CLAUDE ;;
    codex) served=$INSTALL_CODEX ;;
    opencode) served=$INSTALL_OPENCODE ;;
  esac
  if [ "$served" -eq 0 ]; then
    skip_host cursor
  fi
}

# A lone yielded Cursor falls back to Claude, as detecting nothing does; a skipped Codex or OpenCode does not.
if [ "$HOST" = "auto" ] && [ "$SKILLS_DIR_GIVEN" -eq 0 ] && [ "$SKIPPED_NON_CURSOR" -eq 0 ] && ! any_host_selected; then
  INSTALL_CLAUDE=1
fi

# ─── Uninstall ─────────────────────────────────────────────────────
if [ "$UNINSTALL" -eq 1 ]; then
  report_unserved_cursor
  # Every selected host was skipped: uninstall nothing, and leave the shared CLI links alone too.
  if [ "$SKILLS_DIR_GIVEN" -eq 0 ] && ! any_host_selected; then
    log "Nothing uninstalled: skipped $SKIPPED_HOSTS."
    exit 0
  fi
  if [ "$SKILLS_DIR_GIVEN" -eq 1 ]; then
    uninstall_from_dir "$SKILLS_DIR"
  else
    [ "$INSTALL_CLAUDE" -eq 1 ] && uninstall_from_dir "$(host_skills_dir claude)" claude
    [ "$INSTALL_CODEX" -eq 1 ] && uninstall_from_dir "$(host_skills_dir codex)" codex
    [ "$INSTALL_OPENCODE" -eq 1 ] && uninstall_from_dir "$(host_skills_dir opencode)" opencode
    [ "$INSTALL_CURSOR" -eq 1 ] && uninstall_from_dir "$(host_skills_dir cursor)" cursor
  fi

  if [ "$SKILLS_DIR_GIVEN" -eq 0 ]; then
    _keep_links=0
    _kept_links=0
    checkout_has_host_install && _keep_links=1
    for _pair in "gstack-extend|$SCRIPT_DIR/bin/gstack-extend" "gstack-extend-telemetry|$SCRIPT_DIR/bin/gstack-extend-telemetry"; do
      _name="${_pair%%|*}"
      _expected="${_pair#*|}"
      _link="$HOME/.local/bin/$_name"
      _label="$_name"
      [ "$_name" != "gstack-extend" ] || _label="gstack-extend CLI"
      [ -L "$_link" ] || continue
      link_target="$(readlink "$_link" 2>/dev/null || true)"
      if [ "$link_target" = "$_expected" ]; then
        if [ "$_keep_links" -eq 1 ]; then
          log "Kept ~/.local/bin/$_name (this checkout still has a host install)"
          _kept_links=1
        else
          rm -f "$_link"
          log "Removed $_label symlink ($_link)"
        fi
      else
        log "Skipped $_label symlink (points elsewhere: $link_target)"
      fi
    done
    [ "$_kept_links" -eq 0 ] || log "  Install pointer: $HOST_INSTALL_POINTER"
  fi

  log "Uninstall complete."
  exit 0
fi

# ─── Install ───────────────────────────────────────────────────────
# Auto mode skips a detected host whose skills dir fails the install-path check (outside HOME, not yours,
# world-writable) instead of stopping every host; a host named with --host still stops setup.
if [ "$HOST" = "auto" ]; then
  for _host in claude codex opencode cursor; do
    case "$_host" in
      claude) [ "$INSTALL_CLAUDE" -eq 1 ] || continue ;;
      codex) [ "$INSTALL_CODEX" -eq 1 ] || continue ;;
      opencode) [ "$INSTALL_OPENCODE" -eq 1 ] || continue ;;
      cursor) [ "$INSTALL_CURSOR" -eq 1 ] || continue ;;
    esac
    if ! _unsafe=$(is_safe_install_path "$(host_skills_dir "$_host")" 2>&1); then
      echo "Warning: skipping $_host: ${_unsafe#Error: }" >&2
      echo "  Fix that directory, then run setup --host $_host." >&2
      skip_host "$_host"
    fi
  done
fi
report_unserved_cursor
if [ "$HOST" = "auto" ] && ! any_host_selected; then
  # Cursor also reads ~/.claude/skills, so a lone skipped Cursor falls back to Claude as detecting nothing does.
  # Any other skipped host needs its own refreshed copies, so that stays a failure.
  if [ "$SKIPPED_NON_CURSOR" -eq 1 ]; then
    echo "Error: no detected host has a usable skills directory (unsafe, or shared with another host); nothing installed." >&2
    echo "$USAGE" >&2
    exit 1
  fi
  INSTALL_CLAUDE=1
fi

# A --host pass whose host was skipped installs nothing, so it leaves the shared CLI links and registry alone.
if ! any_host_selected; then
  log "Nothing installed: skipped $SKIPPED_HOSTS."
  exit 0
fi

if [ "$INSTALL_CLAUDE" -eq 1 ]; then
  preflight_dir "$(host_skills_dir claude)" claude
fi
if [ "$INSTALL_CODEX" -eq 1 ]; then
  preflight_dir "$(host_skills_dir codex)" codex
fi
if [ "$INSTALL_OPENCODE" -eq 1 ]; then
  preflight_dir "$(host_skills_dir opencode)" opencode
fi
if [ "$INSTALL_CURSOR" -eq 1 ]; then
  preflight_dir "$(host_skills_dir cursor)" cursor
fi

[ "$INSTALL_CLAUDE" -eq 1 ] && install_into_dir "$(host_skills_dir claude)" claude
[ "$INSTALL_CODEX" -eq 1 ] && install_into_dir "$(host_skills_dir codex)" codex
[ "$INSTALL_OPENCODE" -eq 1 ] && install_into_dir "$(host_skills_dir opencode)" opencode
[ "$INSTALL_CURSOR" -eq 1 ] && install_into_dir "$(host_skills_dir cursor)" cursor

cli_bin_dir="$HOME/.local/bin"

wire_bin() {
  local src="$1"
  local name="$2"
  local dst="$cli_bin_dir/$name"
  if [ ! -f "$src" ] || [ ! -x "$src" ]; then
    return 0
  fi
  if [ ! -d "$cli_bin_dir" ]; then
    log "Tip: ~/.local/bin doesn't exist. Either create it and add to PATH,"
    log "  or invoke $name directly: $src"
    return 0
  fi
  if [ -e "$dst" ] && [ ! -L "$dst" ]; then
    echo "Warning: $dst exists and is not a symlink; skipping $name wire" >&2
    return 0
  fi
  ln -snf "$src" "$dst"
  log "Wired $name → $dst"
}

cli_bin_src="$SCRIPT_DIR/bin/gstack-extend"
wire_bin "$cli_bin_src" "gstack-extend"
wire_bin "$SCRIPT_DIR/bin/gstack-extend-telemetry" "gstack-extend-telemetry"

if [ -d "$cli_bin_dir" ] && [ -e "$cli_bin_dir/gstack-extend" ]; then
  case ":$PATH:" in
    *":$cli_bin_dir:"*) ;;
    *) log "  Tip: add $cli_bin_dir to your PATH so wired CLIs resolve directly." ;;
  esac
fi

# _shell_quote <text> — double-quote for a copy-paste retry command.
_shell_quote() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//\$/\\\$}
  s=${s//\`/\\\`}
  s=${s//!/\"\'!\'\"}
  printf '"%s"' "$s"
}

# Records the installed tool in HOME's registry ($HOME/.gstack-extend/projects.json).
# Direct `gstack-extend init` still honors GSTACK_EXTEND_STATE_DIR. Clearing that
# variable for this child only keeps an inherited project-state override from
# redirecting the tool registration. The same unset also selects HOME's effort
# config for this child's audit; direct init keeps the override.
if [ -x "$cli_bin_src" ]; then
  _self_register_log=$(mktemp /tmp/gstack-extend-self-register.XXXXXX)
  _home_registry="$HOME/.gstack-extend/projects.json"
  if env -u GSTACK_EXTEND_STATE_DIR "$cli_bin_src" init --migrate --no-prompt --name gstack-extend "$SCRIPT_DIR" >/dev/null 2>"$_self_register_log"; then
    log "Self-registered gstack-extend in $_home_registry"
  else
    echo "Warning: gstack-extend registration or audit did not complete. Files or a registry entry may already exist." >&2
    if [ -s "$_self_register_log" ]; then
      # The child ran without the caller's state override. Its direct-init
      # retry would inherit that override again, so label it as child context
      # and leave one authoritative, HOME-scoped Retry command below.
      sed 's/^  Retry: /  Child init retry (use setup retry below): /' "$_self_register_log" >&2
    fi
    echo "  Registry: $_home_registry" >&2
    echo "  If that file is corrupt, repair it before retrying. See: gstack-extend init --help" >&2
    echo "  Retry: env -u GSTACK_EXTEND_STATE_DIR $(_shell_quote "$cli_bin_src") init --migrate --no-prompt --name gstack-extend $(_shell_quote "$SCRIPT_DIR")" >&2
  fi
  rm -f "$_self_register_log"
fi
