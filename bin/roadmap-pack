#!/bin/sh
# gstack-extend roadmap-pack — packing CLI, run via bun.
_dir=${0%/*}
[ "$_dir" != "$0" ] || _dir=.
if [ ! -f "$_dir/lib/bun-prereq.sh" ] || [ ! -r "$_dir/lib/bun-prereq.sh" ]; then
  printf '%s\n' 'roadmap-pack: PREREQ_HELPER_MISSING prerequisite helper missing or unreadable; re-run ./setup. No changes were made. See docs/installation.md#requirements.' >&2
  exit 1
fi
. "$_dir/lib/bun-prereq.sh"
if ! bun_prereq_probe; then
  bun_prereq_print_shared 'roadmap-pack' >&2
  exit 1
fi
if ! bun_runtime_deps_check "$_dir/.."; then
  bun_runtime_deps_print_shared 'roadmap-pack' >&2
  exit 1
fi
exec "$BUN_PREREQ_RAW_PATH" --no-env-file --no-install --config=/dev/null "$_dir/../src/audit/pack-cli.ts" "$@"
