#!/bin/sh
# Resolve installed symlinks without depending on dirname or a broad PATH.
set -eu
_bun_version=unknown
_fail() {
  case "$1" in
    bun_missing|bun_not_absolute|bun_too_old|bun_version_unknown)
      printf 'ERROR %s: %s\nFIX: %s\n' "$1" "$2" "$3" >&2
      exit 5 ;;
    *)
      printf 'ERROR INTERNAL: %s: %s\nupstream-check unknown bun %s\nFIX: %s\n' "$1" "$2" "$_bun_version" "$3" >&2
      exit 1 ;;
  esac
}
# Some shells return an absolute `command -v` result even for PATH=.; do not
# let a repository-local bun qualify that way.
_remaining=${PATH-}
_clean_path=
while :; do
  _component=${_remaining%%:*}
  case "$_component" in /*) _clean_path=${_clean_path:+${_clean_path}:}${_component} ;; esac
  case "$_remaining" in *:*) _remaining=${_remaining#*:} ;; *) break ;; esac
done
_missing_fix='install Bun >= 1.3.3 (curl -fsSL https://bun.sh/install | bash and reload your shell or add ~/.bun/bin to PATH), then rerun the same command once; if it still refuses, report this line verbatim. No changes were made. See docs/installation.md#requirements'
[ -n "$_clean_path" ] || _fail bun_missing 'PREREQ_BUN_MISSING upstream-check: bun is not on an absolute PATH entry' "$_missing_fix"
PATH=$_clean_path
export PATH
_bun=$(command -v bun) || _fail bun_missing 'PREREQ_BUN_MISSING upstream-check: bun is not on PATH' "$_missing_fix"
case "$_bun" in
  /*) ;;
  *) _fail bun_not_absolute 'bun must resolve to an absolute path' 'use an absolute PATH entry; see docs/installation.md#requirements' ;;
esac
_src=$0
_hops=0
while [ -L "$_src" ]; do
  _hops=$((_hops + 1))
  [ "$_hops" -le 40 ] || _fail symlink_loop 'symlink loop resolving upstream-check' 'repair the launcher link; see docs/installation.md#requirements'
  _target=$(/usr/bin/readlink "$_src") || _fail symlink_loop 'could not read launcher link' 'repair the launcher link; see docs/installation.md#requirements'
  case "$_target" in
    /*) _src=$_target ;;
    *) _dir=${_src%/*}; [ "$_dir" != "$_src" ] || _dir=.; _src=${_dir}/${_target} ;;
  esac
done
case "$_src" in /*) ;; *) _src=${PWD}/${_src} ;; esac
_bindir=$(cd -P -- "${_src%/*}" && pwd -P)
_helper=${_bindir}/lib/bun-prereq.sh
if [ ! -f "$_helper" ] || [ ! -r "$_helper" ]; then
  _fail source_missing 'PREREQ_HELPER_MISSING upstream-check prerequisite helper missing or unreadable' \
    're-run ./setup from a complete checkout. No changes were made. See docs/installation.md#requirements.'
fi
. "$_helper"
if ! bun_prereq_probe "$_bun"; then
  _fail "$BUN_PREREQ_ERROR_CODE" "$BUN_PREREQ_TOKEN upstream-check: $BUN_PREREQ_WHAT" "$BUN_PREREQ_FIX"
fi
_bun_version=$BUN_PREREQ_FOUND
_root=${_bindir%/*}
_cli=${_root}/src/upstream-check/cli.ts
[ -f "$_cli" ] || _fail source_missing 'upstream-check source missing' 're-run ./setup; see docs/installation.md#requirements'
exec "$BUN_PREREQ_RAW_PATH" --no-env-file --no-install --config=/dev/null "$_cli" "$@"
