#!/bin/sh
# Resolve installed symlinks without depending on dirname or a broad PATH.
set -eu
_fail() {
  case "$1" in
    bun_missing|bun_not_absolute)
      printf 'ERROR %s: %s\nFIX: %s\n' "$1" "$2" "$3" >&2
      exit 5 ;;
    *)
      printf 'ERROR INTERNAL: %s: %s\nupstream-check unknown bun %s\nFIX: %s\n' "$1" "$2" "$("$_bun" --version)" "$3" >&2
      exit 1 ;;
  esac
}
# Some shells return an absolute `command -v` result even for PATH=.; do not
# let a repository-local bun qualify that way.
_remaining=${PATH-}
_clean_path=
while :; do
  _component=${_remaining%%:*}
  case "$_component" in /*) _clean_path=${_clean_path:+${_clean_path}:}${_component} ;; esac
  case "$_remaining" in *:*) _remaining=${_remaining#*:} ;; *) break ;; esac
done
[ -n "$_clean_path" ] || _fail bun_missing 'bun is not on an absolute PATH entry' 'install Bun >= 1.3.3; see upstream-check --help'
PATH=$_clean_path
export PATH
_bun=$(command -v bun) || _fail bun_missing 'bun is not on PATH' 'install Bun >= 1.3.3; see upstream-check --help'
case "$_bun" in
  /*) ;;
  *) _fail bun_not_absolute 'bun must resolve to an absolute path' 'use an absolute PATH entry; see upstream-check --help' ;;
esac
_src=$0
_hops=0
while [ -L "$_src" ]; do
  _hops=$((_hops + 1))
  [ "$_hops" -le 40 ] || _fail symlink_loop 'symlink loop resolving upstream-check' 'repair the launcher link; see upstream-check --help'
  _target=$(/usr/bin/readlink "$_src") || _fail symlink_loop 'could not read launcher link' 'repair the launcher link; see upstream-check --help'
  case "$_target" in
    /*) _src=$_target ;;
    *) _dir=${_src%/*}; [ "$_dir" != "$_src" ] || _dir=.; _src=${_dir}/${_target} ;;
  esac
done
case "$_src" in /*) ;; *) _src=${PWD}/${_src} ;; esac
_bindir=$(cd -P -- "${_src%/*}" && pwd -P)
_root=${_bindir%/*}
_cli=${_root}/src/upstream-check/cli.ts
[ -f "$_cli" ] || _fail source_missing 'upstream-check source missing' 're-run ./setup; see upstream-check --help'
exec bun --no-env-file --no-install --config=/dev/null "$_cli" "$@"
