#!/bin/sh
# Shadow merge gate. Resolves this file through symlinks without dirname so a
# PATH that contains only bun can still start it.
set -eu

_json=0
for _a in "$@"; do
  case "$_a" in
    --json|--jsonl) _json=1 ;;
  esac
done

_fail() {
  if [ "$_json" -eq 1 ]; then
    # Canonical key order, byte-identical to the CLI's JSON errors.
    printf '%s\n' "{\"error\":{\"code\":\"$1\",\"doc\":\"docs/merge-gate.md#errors\",\"fix\":\"$3\",\"message\":\"$2\"},\"v\":1}"
  else
    echo "ERROR $1: $2" >&2
    echo "FIX: $3" >&2
  fi
  exit 1
}

_src=$0
_hops=0
while [ -L "$_src" ]; do
  _hops=$((_hops + 1))
  if [ "$_hops" -gt 40 ]; then
    _fail internal_error "symlink loop resolving merge-gate" "repair the symlink. See docs/merge-gate.md"
  fi
  _resolved=$(/usr/bin/readlink "$_src") || _fail internal_error "could not read symlink" "repair the symlink. See docs/merge-gate.md"
  case "$_resolved" in
    /*) _src=$_resolved ;;
    *)
      _dir=${_src%/*}
      [ "$_dir" = "$_src" ] && _dir=.
      _src=${_dir}/${_resolved}
      ;;
  esac
done
case "$_src" in
  /*) ;;
  *) _src=${PWD}/${_src} ;;
esac

_bindir=${_src%/*}
_root=${_bindir%/*}
_cli=${_root}/src/merge-gate/cli.ts
_helper=${_bindir}/lib/bun-prereq.sh
if [ ! -f "$_helper" ] || [ ! -r "$_helper" ]; then
  if [ ! -f "$_cli" ]; then
    _fail internal_error "merge-gate source missing" "re-run ~/.claude/skills/gstack-extend/setup"
  fi
  _fail internal_error 'PREREQ_HELPER_MISSING merge-gate prerequisite helper missing or unreadable' 're-run ./setup from a complete checkout. No changes were made. See docs/installation.md#requirements.'
fi
. "$_helper"
if ! bun_prereq_probe; then
  _fail "$BUN_PREREQ_ERROR_CODE" "$BUN_PREREQ_TOKEN merge-gate: $BUN_PREREQ_WHAT" "$BUN_PREREQ_FIX"
fi

if [ ! -f "$_cli" ]; then
  _fail internal_error "merge-gate source missing" "re-run ~/.claude/skills/gstack-extend/setup"
fi

exec "$BUN_PREREQ_RAW_PATH" --no-env-file --no-install --config=/dev/null "$_cli" "$@"
