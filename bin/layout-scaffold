#!/bin/sh
# Resolve installed symlinks without depending on dirname or a broad PATH.
set -eu
_fail() {
  printf 'ERROR %s: %s\nFIX: %s\n' "$1" "$2" "$3" >&2
  exit 5
}
# Some shells return an absolute `command -v` result even for PATH=.; do not
# let a repository-local bun qualify that way.
_remaining=${PATH-}
_clean_path=
while :; do
  _component=${_remaining%%:*}
  case "$_component" in /*) _clean_path=${_clean_path:+${_clean_path}:}${_component} ;; esac
  case "$_remaining" in *:*) _remaining=${_remaining#*:} ;; *) break ;; esac
done
[ -n "$_clean_path" ] || _fail bun_missing 'bun is not on an absolute PATH entry' 'install Bun >= 1.3.3; see layout-scaffold --help'
PATH=$_clean_path
export PATH
_bun=$(command -v bun) || _fail bun_missing 'bun is not on PATH' 'install Bun >= 1.3.3; see layout-scaffold --help'
case "$_bun" in
  /*) ;;
  *) _fail bun_not_absolute 'bun must resolve to an absolute path' 'use an absolute PATH entry; see layout-scaffold --help' ;;
esac
_src=$0
_hops=0
while [ -L "$_src" ]; do
  _hops=$((_hops + 1))
  [ "$_hops" -le 40 ] || _fail symlink_loop 'symlink loop resolving layout-scaffold' 'repair the launcher link; see layout-scaffold --help'
  _target=$(/usr/bin/readlink "$_src") || _fail symlink_loop 'could not read launcher link' 'repair the launcher link; see layout-scaffold --help'
  case "$_target" in
    /*) _src=$_target ;;
    *) _dir=${_src%/*}; [ "$_dir" != "$_src" ] || _dir=.; _src=${_dir}/${_target} ;;
  esac
done
case "$_src" in /*) ;; *) _src=${PWD}/${_src} ;; esac
_bindir=$(cd -P -- "${_src%/*}" && pwd -P)
_root=${_bindir%/*}
_cli=${_root}/src/layout-scaffold/cli.ts
[ -f "$_cli" ] || _fail source_missing 'layout-scaffold source missing' 're-run ./setup; see layout-scaffold --help'
exec bun --no-env-file --no-install --config=/dev/null "$_cli" "$@"
