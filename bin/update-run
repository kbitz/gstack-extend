#!/usr/bin/env bash
# gstack-extend update-run — perform the actual upgrade.
#
# Usage:
#   bin/update-run <repo-root>
#
# The repo root is passed from the skill preamble (resolved via readlink).
# This avoids hardcoding paths and works regardless of where the repo is cloned.
#
# Output:
#   UPGRADE_OK <old> <new>      — checkout upgraded; hosts in SETUP_SKIPPED_HOSTS were not refreshed
#   UPGRADE_FAILED <reason>     — upgrade failed
# Additional lines, before the result:
#   UPGRADE_MISMATCH offered=<v> installed=<v> channel=main — main changed since the offer
#   SETUP_SKIPPED_HOSTS <csv>   — forwarded from setup: it left these hosts untouched
#   MIGRATION_WARN <script> exit=<n> — forwarded from run-migrations.sh: a migration or its helper failed
#   INSTALL_WARN ...            — forwarded from setup when install diagnostics could not be saved
# INSTALL_WARN is not an upgrade result. Exactly one UPGRADE_OK or UPGRADE_FAILED
# line is still the outcome. A later update-check prints saved install facts.
#
# Exactly one result line is always emitted. The script runs under `set -e`;
# an EXIT trap guarantees a UPGRADE_FAILED line even when a git stage dies
# mid-run, and best-effort-restores the branch + stash before reporting so a
# failed upgrade does not strand the user on main with work stashed.
set -euo pipefail

INSTALL_DIR="${1:-}"
STATE_DIR="${GSTACK_EXTEND_STATE_DIR:-$HOME/.gstack-extend}"

# ─── Pre-flight (before the trap — these self-report and INSTALL_DIR may
#     be empty/invalid, so the trap's git restoration must not run) ──────
if [ -z "$INSTALL_DIR" ]; then
  echo "UPGRADE_FAILED missing repo root argument"
  exit 1
fi

if [ ! -d "$INSTALL_DIR/.git" ]; then
  echo "UPGRADE_FAILED not a git repo: $INSTALL_DIR"
  exit 1
fi

# ─── EXIT trap: guarantee a result line + best-effort state restore ─────
# _RESULT_EMITTED guards double-emit: every explicit UPGRADE_OK/UPGRADE_FAILED
# echo sets it, and the trap stays silent when it is set. The trap only acts
# on a NONZERO exit — a clean exit 0 after UPGRADE_OK must not produce a
# spurious failure. _STAGE names the failed step. _PREV_BRANCH / _STASHED
# track restorable state created during the run.
_STAGE="init"
_RESULT_EMITTED=""
_PREV_BRANCH=""
_STASHED=""

# restore_stash — pop the update-run stash, but ONLY when we are back on the
# branch it was taken from, and clear _STASHED on success. Two guards in one:
#   - Branch check: popping onto the wrong branch would apply the user's
#     branch-local work somewhere it doesn't belong (e.g. onto main after a
#     failed checkout-restore) while the run still reports success.
#   - Clear-on-success: without this, a later failure (and the EXIT trap)
#     could pop a SECOND time and silently drop an unrelated stash entry.
restore_stash() {
  [ -n "$_STASHED" ] || return 0
  _RS_CUR=$(git -C "$INSTALL_DIR" branch --show-current 2>/dev/null || true)
  if [ "$_RS_CUR" != "$_PREV_BRANCH" ]; then
    echo "Note: could not return to branch '$_PREV_BRANCH' — your changes remain stashed. Run 'git -C $INSTALL_DIR stash pop' after checking out '$_PREV_BRANCH'."
    return 0
  fi
  if git -C "$INSTALL_DIR" stash pop 2>/dev/null; then
    _STASHED=""
  else
    echo "Note: local changes were stashed but could not be restored. Run 'git -C $INSTALL_DIR stash pop' manually."
  fi
}

restore_checkout() {
  if [ -n "$_PREV_BRANCH" ] && [ "$_PREV_BRANCH" != "main" ]; then
    git -C "$INSTALL_DIR" checkout "$_PREV_BRANCH" 2>/dev/null || true
  fi
  restore_stash
}

fail_upgrade() {
  restore_checkout
  _RESULT_EMITTED=1
  echo "UPGRADE_FAILED $1"
  exit 1
}

on_exit() {
  _ec=$?
  [ "$_ec" -eq 0 ] && return 0
  [ -n "$_RESULT_EMITTED" ] && return 0
  # Best-effort restoration: leave the worktree as if we never ran.
  restore_checkout
  _RESULT_EMITTED=1
  echo "UPGRADE_FAILED stage=$_STAGE (exit $_ec)"
}
trap on_exit EXIT

# ─── Step 1: Save old version ─────────────────────────────────
_STAGE="read-version"
OLD_VERSION=$(cat "$INSTALL_DIR/VERSION" 2>/dev/null | tr -d '[:space:]' || echo "unknown")
PRE_PULL_VERSION=$OLD_VERSION
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
CHANNEL=main
if [ -f "$SCRIPT_DIR/lib/update-channel.sh" ]; then
  source "$SCRIPT_DIR/lib/semver.sh"
  source "$SCRIPT_DIR/lib/update-channel.sh"
  CHANNEL=$(update_channel "$INSTALL_DIR")
fi

# ─── Step 2: Upgrade via git ──────────────────────────────────
_STAGE="mkdir-state"
mkdir -p "$STATE_DIR"

# Persist pre-pull OLD so a setup/helper miss cannot collapse the next
# hop to OLD==NEW with an empty window. Write only if absent or not
# semver. Helper finish_scan clears it; the helper EXIT trap does not.
_HOP_FROM="$STATE_DIR/migrations-hop-from"
_hop_is_semver() {
  case "$1" in
    *[!0-9.]*) return 1 ;;
    [0-9]*.[0-9]*.[0-9]*) return 0 ;;
    *) return 1 ;;
  esac
}
_HOP_EXISTING=""
if [ -f "$_HOP_FROM" ]; then
  _HOP_EXISTING=$(tr -d '[:space:]' < "$_HOP_FROM" || true)
fi
if ! _hop_is_semver "$_HOP_EXISTING"; then
  if _hop_is_semver "$OLD_VERSION"; then
    printf '%s\n' "$OLD_VERSION" > "$_HOP_FROM"
  fi
fi

_STAGE="read-branch"
_PREV_BRANCH=$(git -C "$INSTALL_DIR" branch --show-current 2>/dev/null || true)

_STAGE="stash"
STASH_OUTPUT=$(git -C "$INSTALL_DIR" stash 2>&1)
if echo "$STASH_OUTPUT" | grep -q "Saved working directory"; then
  _STASHED=1
fi

_STAGE="fetch"
git -C "$INSTALL_DIR" fetch origin

# Both lines are read from the same cache snapshot. A one-line cache was
# written by the main-tracking checker.
CACHED="" CACHED_IDENTITY=""
{
  read -r CACHED || true
  read -r CACHED_IDENTITY || true
} 2>/dev/null < "$STATE_DIR/last-update-check" || true
read -r OFFER_STATUS OFFER_LOCAL OFFER_VERSION <<< "$CACHED"
if [ "$OFFER_STATUS" != UPGRADE_AVAILABLE ] || [ "$OFFER_LOCAL" != "$PRE_PULL_VERSION" ]; then
  OFFER_VERSION=""
fi

RELEASE_TAG="" RELEASE_COMMIT=""
if [ "$CHANNEL" = stable ]; then
  _STAGE="resolve-release"
  STABLE_IDENTITY_RE='^IDENTITY channel=stable tag=(v[^ ]+) commit=([0-9a-f]{40})$'
  RECORDED_OFFER=0
  if [ -n "$OFFER_VERSION" ] && [[ "$CACHED_IDENTITY" =~ $STABLE_IDENTITY_RE ]]; then
    RELEASE_TAG=${BASH_REMATCH[1]}
    RELEASE_COMMIT=${BASH_REMATCH[2]}
    RELEASE_VERSION=${RELEASE_TAG#v}
    RECORDED_OFFER=1
  elif RELEASE=$(update_latest_release "$INSTALL_DIR" 2>/dev/null); then
    read -r RELEASE_VERSION RELEASE_TAG RELEASE_COMMIT <<< "$RELEASE"
  elif [ "$?" -ne 2 ]; then
    fail_upgrade "stage=resolve-release could not list origin release tags"
  fi

  if [ -n "$RELEASE_TAG" ]; then
    MISMATCH=""
    CONFIRMED_COMMIT=""
    if [ "$RECORDED_OFFER" -eq 1 ]; then
      if CONFIRMED_COMMIT=$(update_remote_tag_commit "$INSTALL_DIR" "$RELEASE_TAG" 2>/dev/null); then
        :
      elif [ "$?" -ne 2 ]; then
        fail_upgrade "stage=resolve-release could not verify origin release tag $RELEASE_TAG; retry when origin is reachable"
      fi
    fi
    if [ "$RECORDED_OFFER" -eq 1 ] &&
       [ "$CONFIRMED_COMMIT" != "$RELEASE_COMMIT" ]; then
      MISMATCH="origin no longer confirms the offered tag commit"
    elif [ "$(git -C "$INSTALL_DIR" cat-file -t "$RELEASE_COMMIT" 2>/dev/null || true)" != commit ]; then
      MISMATCH="commit is missing after fetch"
    elif ! git -C "$INSTALL_DIR" merge-base --is-ancestor "$RELEASE_COMMIT" refs/remotes/origin/main 2>/dev/null; then
      MISMATCH="commit is outside origin/main"
    elif [ "$(git -C "$INSTALL_DIR" show "$RELEASE_COMMIT:VERSION" 2>/dev/null | tr -d '[:space:]' || true)" != "$RELEASE_VERSION" ]; then
      MISMATCH="commit VERSION differs from the tag"
    elif [ "$RECORDED_OFFER" -eq 1 ] && [ "$OFFER_VERSION" != "$RELEASE_VERSION" ]; then
      MISMATCH="offered VERSION differs from the tag"
    fi
    if [ -n "$MISMATCH" ]; then
      fail_upgrade "release mismatch: $RELEASE_TAG ${RELEASE_COMMIT:0:12}: $MISMATCH. Run bin/update-check --force, then rerun the updater."
    fi
  fi
fi

# Switch to main if on a different branch
if [ -n "$_PREV_BRANCH" ] && [ "$_PREV_BRANCH" != "main" ]; then
  _STAGE="checkout-main"
  git -C "$INSTALL_DIR" checkout main
  echo "Note: switched from branch '$_PREV_BRANCH' to main for upgrade."
fi

# Fast-forward only — if main has diverged locally, fail safely instead of destroying work
_STAGE="pull-ff-only"
if [ -n "$RELEASE_TAG" ]; then
  # Git also reports success when HEAD is already ahead of the target.
  # Require the installed commit to be the release commit.
  if ! git -C "$INSTALL_DIR" merge-base --is-ancestor HEAD "$RELEASE_COMMIT" ||
     ! git -C "$INSTALL_DIR" merge --ff-only "$RELEASE_COMMIT" ||
     [ "$(git -C "$INSTALL_DIR" rev-parse HEAD)" != "$RELEASE_COMMIT" ]; then
    fail_upgrade "local main cannot fast-forward to release $RELEASE_TAG (ff-only failed)"
  fi
elif ! git -C "$INSTALL_DIR" pull --ff-only origin main; then
  fail_upgrade "local main has diverged from origin/main (ff-only failed)"
fi

_STAGE="setup"
# Forward setup stdout verbatim, including SETUP_SKIPPED_HOSTS even on failure.
"$INSTALL_DIR/setup" --host auto --quiet

# Read NEW after pull so the helper sees the landed VERSION. Insert before
# checkout-restore so scripts run on the pulled main tree, not a dirty
# feature branch. A pre-15B update-run that pulled this file will not
# reach this call site — first reliable hop is the upgrade after 15B.
_STAGE="read-new-version"
NEW_VERSION=$(cat "$INSTALL_DIR/VERSION" 2>/dev/null | tr -d '[:space:]' || echo "unknown")
if [ "$CHANNEL" = main ] && [ -n "$OFFER_VERSION" ] && [ "$OFFER_VERSION" != "$NEW_VERSION" ]; then
  case "$CACHED_IDENTITY" in
    ""|"IDENTITY channel=main "*)
      echo "UPGRADE_MISMATCH offered=$OFFER_VERSION installed=$NEW_VERSION channel=main"
      ;;
  esac
fi

if [ -f "$_HOP_FROM" ]; then
  _HOP_OLD=$(tr -d '[:space:]' < "$_HOP_FROM" || true)
  if _hop_is_semver "$_HOP_OLD"; then
    OLD_VERSION="$_HOP_OLD"
  fi
fi

_STAGE="migrations"
if [ -f "$INSTALL_DIR/bin/lib/run-migrations.sh" ]; then
  bash "$INSTALL_DIR/bin/lib/run-migrations.sh" \
    "$INSTALL_DIR" "$STATE_DIR" "$OLD_VERSION" "$NEW_VERSION" \
    || true
fi

# Switch back to previous branch if we moved away (best-effort)
if [ -n "$_PREV_BRANCH" ] && [ "$_PREV_BRANCH" != "main" ]; then
  _STAGE="checkout-restore"
  git -C "$INSTALL_DIR" checkout "$_PREV_BRANCH" 2>/dev/null || true
fi

# Restore stashed changes on the original branch (branch-checked, best-effort)
_STAGE="stash-pop"
restore_stash

# ─── Step 3: Write upgrade marker ─────────────────────────────
_STAGE="write-marker"
echo "$OLD_VERSION" > "$STATE_DIR/just-upgraded-from"

# Clear cache so next check is fresh
_STAGE="clear-cache"
rm -f "$STATE_DIR/last-update-check"
rm -f "$STATE_DIR/update-snoozed"

_STAGE="done"
_RESULT_EMITTED=1
echo "UPGRADE_OK $OLD_VERSION $NEW_VERSION"
