#!/usr/bin/env bash
# gstack-extend — project-lifecycle CLI for gstack-extend-onboarded projects.
#
# Subcommands:
#   init <project>     Bootstrap a new project: scaffold canonical layout,
#                      render starter docs, register in ~/.gstack-extend/projects.json,
#                      run post-render audit. See `init --help` for flags.
#   list               (reserved namespace) — coming in a future Group
#   status             (reserved namespace) — coming in a future Group
#   doctor telemetry   Report local skill telemetry fidelity (always exits 0)
#   migrate            (reserved namespace) — coming in a future Group
#                      (single-project backfill is `init --migrate <dir>`)
#
# Flag matrix for `init` (default | --dry-run | --no-prompt | --migrate)
#   x (empty / partial / onboarded) target-dir state — see init --help.
#
# Distribution: installed by `setup` as a symlink at ~/.local/bin/gstack-extend.
# All filesystem state lives under ~/.gstack-extend/ (override via
# GSTACK_EXTEND_STATE_DIR; matches bin/config:11). Tests that exercise the
# audit gate must ALSO set GSTACK_STATE_ROOT to isolate ~/.gstack/.

set -euo pipefail

# An exported CDPATH makes `cd <relative>` jump elsewhere and print the
# match, which would corrupt every path this script resolves with cd.
unset CDPATH

# ─── Self-location (POSIX-portable readlink) ───────────────────────────
#
# bin/gstack-extend may be invoked through ~/.local/bin/gstack-extend, which
# is a symlink into the gstack-extend repo. macOS BSD readlink lacks `-f`;
# walk the symlink chain in pure bash so the same code works on Linux and
# macOS without coreutils. End state: SCRIPT_DIR points at the real bin/.
_self_resolve() {
  local src="$1"
  local hops=0
  # Bail after SYMLOOP_MAX (POSIX min 8; coreutils uses 40) to refuse
  # infinite recursion on cyclic symlinks. `readlink -f` does this
  # natively; the pure-bash walker has to do it explicitly.
  while [ -L "$src" ]; do
    hops=$((hops + 1))
    if [ "$hops" -gt 40 ]; then
      echo "gstack-extend: symlink loop detected resolving $1" >&2
      exit 1
    fi
    local dir
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case "$src" in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  cd -P "$(dirname "$src")" && pwd
}

SCRIPT_DIR=$(_self_resolve "$0")
REPO_ROOT=$(cd -P "$SCRIPT_DIR/.." && pwd)
TEMPLATES_DIR="$REPO_ROOT/scripts/init-templates"

# shellcheck source=bin/lib/install-safety.sh
. "$SCRIPT_DIR/lib/install-safety.sh"
# shellcheck source=bin/lib/projects-registry.sh
. "$SCRIPT_DIR/lib/projects-registry.sh"

# ERR trap — make set -e exits visible (line + code + call stack) rather
# than silent. Shared helper from install-safety.sh; existing bins adopt
# as they're touched.
trap '_die_with_line $?' ERR

# ─── Constants ─────────────────────────────────────────────────────────

# Canonical files init scaffolds. The defensive-minimal scaffold (D2.B)
# refuses if ANY of these already exist in the target dir (default mode),
# unless --migrate is passed.
#
# CHANGELOG.md lives at root (matches gstack-extend itself + DOC_LOCATION
# audit expectation) — not under docs/. Tools and platforms expect it
# there (GitHub auto-links a root CHANGELOG.md on the releases page).
CANONICAL_FILES=(
  CLAUDE.md
  CHANGELOG.md
  VERSION
  docs/ROADMAP.md
  docs/TODOS.md
  docs/PROGRESS.md
  docs/roadmap-future.md
  docs/roadmap-shipped.md
)

CANONICAL_DIRS=(
  docs
  docs/designs
  docs/archive
)

COMING_SOON_MSG='reserved namespace — coming in a future Group'

# ─── Helpers ───────────────────────────────────────────────────────────

# validate_name <name>
# Names must match [a-zA-Z0-9._-]+. Refuses empty + shell-special chars.
# Used for both --name and the basename of <project> when --name is unset.
validate_name() {
  local name="$1"
  if [ -z "$name" ]; then
    echo "gstack-extend init: project name is empty" >&2
    echo "  Pass a valid display name with --name <valid-name>." >&2
    return 1
  fi
  case "$name" in
    *[!a-zA-Z0-9._-]*)
      echo "gstack-extend init: project name '$name' contains invalid characters" >&2
      echo "  Allowed: letters, digits, dot, underscore, hyphen." >&2
      echo "  Pass a valid display name with --name <valid-name>." >&2
      return 1
      ;;
  esac
  return 0
}

# shell_quote <text>
# Double-quote a value for a copy-paste shell command. Escapes \, ", $, `;
# quote ! separately because interactive Bash expands it inside double quotes.
shell_quote() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//\$/\\\$}
  s=${s//\`/\\\`}
  s=${s//!/\"\'!\'\"}
  printf '"%s"' "$s"
}

# init_mkdir <dir>
# Explicit status: cmd_init is invoked conditionally, so set -e/ERR will not
# stop the dispatcher when mkdir fails. GSTACK_EXTEND_INIT_MKDIR_FAIL is a
# test seam that fails creation of one exact path.
init_mkdir() {
  local dest="$1"
  if [ -n "${GSTACK_EXTEND_INIT_MKDIR_FAIL:-}" ] && [ "$dest" = "$GSTACK_EXTEND_INIT_MKDIR_FAIL" ]; then
    echo "gstack-extend init: cannot create directory $dest" >&2
    return 1
  fi
  if ! mkdir -p -- "$dest"; then
    echo "gstack-extend init: cannot create directory $dest" >&2
    return 1
  fi
}

# detect_lang <dir>
# Echoes a known runtime label or "unknown". Used only to seed the
# test-command line in CLAUDE.md; never gates init success.
#
# EXTRACT: bin/lib/lang-detect.sh when a second caller arrives. Today only
# render() needs this — splitting it out now is premature abstraction.
detect_lang() {
  local dir="$1"
  if [ -f "$dir/package.json" ];                                  then echo bun;    return 0; fi
  if [ -f "$dir/Cargo.toml" ];                                    then echo cargo;  return 0; fi
  if [ -f "$dir/go.mod" ];                                        then echo go;     return 0; fi
  if [ -f "$dir/pyproject.toml" ] || [ -f "$dir/requirements.txt" ]; then echo python; return 0; fi
  echo unknown
}

# test_cmd_block <lang>
# Echoes the multi-line CLAUDE.md "Testing" body for the detected lang.
# Stays one variable substitution in the template so the template doesn't
# branch on language.
test_cmd_block() {
  local lang="$1"
  case "$lang" in
    bun)    printf '```bash\nbun run test     # run the project test suite\n```\n' ;;
    cargo)  printf '```bash\ncargo test       # run the project test suite\n```\n' ;;
    go)     printf '```bash\ngo test ./...    # run the project test suite\n```\n' ;;
    python) printf '```bash\npytest           # run the project test suite\n```\n' ;;
    *)      printf '_TODO: define the project test command and document it here._\n' ;;
  esac
}

# detect_slug <dir>
# Slug derivation: git remote owner-repo → fallback basename. Sanitized to
# [a-zA-Z0-9._-]. Used as the registry key and for ~/.gstack/projects/<slug>.
detect_slug() {
  local dir="$1"
  local remote=""
  if [ -d "$dir/.git" ] || git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    remote=$(git -C "$dir" config --get remote.origin.url 2>/dev/null || true)
  fi
  if [ -n "$remote" ]; then
    # Strip .git, drop everything before the last colon-or-slash pair.
    # Examples:
    #   https://github.com/owner/repo.git → owner-repo
    #   git@github.com:owner/repo.git     → owner-repo
    local stripped="${remote%.git}"
    local repo="${stripped##*/}"
    local owner_path="${stripped%/*}"
    local owner="${owner_path##*[:/]}"
    if [ -n "$owner" ] && [ -n "$repo" ] && [ "$owner" != "$stripped" ]; then
      printf '%s-%s' "$owner" "$repo" | tr -cd 'a-zA-Z0-9._-'
      return 0
    fi
  fi
  basename "$dir" | tr -cd 'a-zA-Z0-9._-'
}

# detect_remote <dir>
# Echoes the git remote URL or empty string if no remote / no .git.
detect_remote() {
  local dir="$1"
  if git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "$dir" config --get remote.origin.url 2>/dev/null || true
  fi
}

# detect_base_branch <dir>
# Best-effort base branch detection: symbolic-ref of origin/HEAD → main →
# master → "main" (default). Mirrors how /roadmap detects.
detect_base_branch() {
  local dir="$1"
  if ! git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    echo main
    return 0
  fi
  local ref
  if ref=$(git -C "$dir" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null); then
    printf '%s' "${ref#refs/remotes/origin/}"
    return 0
  fi
  for b in main master; do
    if git -C "$dir" rev-parse --verify "origin/$b" >/dev/null 2>&1; then
      echo "$b"
      return 0
    fi
  done
  echo main
}

# path_occupied <path>
# True when <path> exists or is a symlink, dangling or not. `[ -e ]` alone
# follows links, so a dangling CLAUDE.md -> ../outside would read as free
# and a write would land outside the project.
path_occupied() {
  [ -e "$1" ] || [ -L "$1" ]
}

# physical_dir <dir>
# Sets PHYSICAL_DIR to the physical path of existing directory <dir>;
# returns 1 if it cannot be entered. External pwd -P asks the kernel, so on
# case-insensitive APFS it gives the on-disk case where bash's builtin
# keeps the typed case. The "." sentinel keeps a trailing newline in a
# directory name, which command substitution would otherwise strip.
physical_dir() {
  local out
  out=$(cd -P -- "$1" 2>/dev/null && { /bin/pwd -P 2>/dev/null || pwd -P; } && printf .) || return 1
  out=${out%.}
  PHYSICAL_DIR=${out%$'\n'}
}

# write_problem <target> <path>
# For a file or directory init is about to create under <target>, echoes
# why it must not be created, or nothing. Walks up to the nearest existing
# ancestor: it must be a directory whose physical path is <target> or below
# (a link such as docs -> ../elsewhere fails). Existing paths are never
# checked here, so a linked docs/ that needs no writes is left alone.
# <target> is already physical (physical_dir).
write_problem() {
  local target="$1" p="${2%/*}"
  while [ "$p" != "$target" ] && [ ! -e "$p" ]; do
    if [ -L "$p" ]; then
      printf '%s is a dangling link' "${p#"$target"/}"
      return 0
    fi
    p=${p%/*}
  done
  [ "$p" = "$target" ] && return 0
  if [ ! -d "$p" ]; then
    printf '%s is not a directory' "${p#"$target"/}"
    return 0
  fi
  if ! physical_dir "$p"; then
    printf 'cannot enter %s to check where it leads' "${p#"$target"/}"
    return 0
  fi
  case "$PHYSICAL_DIR/" in
    "$target"/*) return 0 ;;
  esac
  printf '%s resolves outside the project (%s)' "${p#"$target"/}" "$PHYSICAL_DIR"
}

# roadmap_present <target>
# True when a ROADMAP exists at docs/ or the root. path_occupied, not -f:
# a dangling ROADMAP link still means a ROADMAP is expected there, so the
# satellites stay skipped.
roadmap_present() {
  path_occupied "$1/docs/ROADMAP.md" || path_occupied "$1/ROADMAP.md"
}

# detect_state <dir>
# Echoes one of: empty | partial | onboarded.
#   onboarded: all canonical files present AND projects.json has the
#              derived slug or an entry at <dir> (adding a remote after
#              init changes the derived slug, not the registered path)
#   partial:   any canonical file present
#   empty:     no canonical files present
# Caller-supplied <dir> need not exist (returns "empty" for non-existent).
detect_state() {
  local dir="$1"
  local slug
  slug=$(detect_slug "$dir")
  local any_present=0
  if [ -d "$dir" ]; then
    local f
    for f in "${CANONICAL_FILES[@]}"; do
      if path_occupied "$dir/$f"; then any_present=1; break; fi
    done
  fi
  if [ "$any_present" = "0" ]; then
    echo empty
    return 0
  fi
  local all_present=1
  for f in "${CANONICAL_FILES[@]}"; do
    if [ ! -e "$dir/$f" ]; then all_present=0; break; fi
  done
  if [ "$all_present" = "1" ] && {
       registry_has_slug "$slug" 2>/dev/null \
         || registry_slugs_for_path "$dir" >/dev/null 2>&1
     }; then
    echo onboarded
  else
    echo partial
  fi
}

# template_substitute <tmpl-path> <var=value>...
# Renders a template to stdout, substituting {{var}} → value for each
# var=value pair. Refuses if any {{...}} placeholders remain unsubstituted
# (catches typo'd template vars in CI).
template_substitute() {
  local tmpl="$1"
  shift
  if [ ! -f "$tmpl" ]; then
    echo "template_substitute: missing template: $tmpl" >&2
    return 1
  fi
  local content
  content=$(cat "$tmpl")
  local kv key val
  for kv in "$@"; do
    key="${kv%%=*}"
    val="${kv#*=}"
    # Bash builtin replacement avoids sed-escaping woes with special chars.
    content="${content//\{\{${key}\}\}/${val}}"
  done
  # Surface any unsubstituted placeholders so we fail loud rather than ship
  # half-rendered docs.
  if printf '%s' "$content" | grep -q '{{[a-zA-Z_]*}}'; then
    echo "template_substitute: unsubstituted placeholders remain in $tmpl:" >&2
    printf '%s' "$content" | grep -o '{{[a-zA-Z_]*}}' | sort -u >&2
    return 1
  fi
  printf '%s' "$content"
}

# render_action <target> <dest> <had_roadmap>
# The one per-file decision behind both --dry-run and the real write, so
# the preview can never describe a path the write does not take:
#   skip-link       <dest> is a dangling symlink. init never writes through
#                   a link; the user fixes or removes it.
#   skip-existing   <dest> exists. --migrate only backfills missing files;
#                   nothing is ever overwritten. scaffold_layout's preflight
#                   refuses any create that would land outside <target>.
#   skip-satellite  Future/Shipped satellite next to a ROADMAP that existed
#                   before this run. /roadmap copies the live tail on first
#                   apply; an empty stub plus leftover inline bullets is how
#                   deferred essays get deleted.
#   create          everything else (greenfield writes both satellites
#                   after the template ROADMAP).
render_action() {
  local target="$1" dest="$2" had_roadmap="$3"
  if [ -L "$target/$dest" ] && [ ! -e "$target/$dest" ]; then
    echo skip-link
    return 0
  fi
  if path_occupied "$target/$dest"; then
    echo skip-existing
    return 0
  fi
  if [ "$had_roadmap" = "1" ]; then
    case "$dest" in
      docs/roadmap-future.md|docs/roadmap-shipped.md)
        echo skip-satellite
        return 0
        ;;
    esac
  fi
  echo create
}

# render_all <target> <dry_run> <KV ARGS...>
# Renders every CANONICAL_FILES entry. The template is that destination's
# basename plus .tmpl (basenames are unique). Honors dry_run=1, printing
# the same render_action decision the real write would apply.
# On real write, creates parent dirs as needed. Default mode never reaches
# skip-existing or skip-link (an occupied canonical path is refused first)
# but can reach skip-satellite through a root ROADMAP.md.
render_all() {
  local target="$1" dry_run="$2"
  shift 2
  local vars=("$@")

  local had_roadmap=0
  if roadmap_present "$target"; then
    had_roadmap=1
  fi

  local dest tmpl content out parent action reason n
  for dest in "${CANONICAL_FILES[@]}"; do
    tmpl="${dest##*/}.tmpl"
    out="$target/$dest"
    if ! content=$(template_substitute "$TEMPLATES_DIR/$tmpl" "${vars[@]}"); then
      return 1
    fi
    action=$(render_action "$target" "$dest" "$had_roadmap")
    case "$action" in
      skip-link)      reason='dangling symlink; init never writes through a link' ;;
      skip-existing)  reason='already exists; --migrate only backfills missing files' ;;
      skip-satellite) reason='ROADMAP already exists; /roadmap migrates the live tail' ;;
      *)              reason='' ;;
    esac
    if [ "$dry_run" = "1" ]; then
      if [ "$action" = "create" ]; then
        n=$(printf '%s\n' "$content" | wc -l | tr -d ' ')
        printf '  + would create %s (%s lines)\n' "$out" "$n"
      else
        printf '  ~ would skip   %s (%s)\n' "$out" "$reason"
      fi
      continue
    fi
    if [ "$action" != "create" ]; then
      echo "  ~ skipped $dest ($reason)"
      continue
    fi
    parent=$(dirname "$out")
    if ! init_mkdir "$parent"; then
      return 1
    fi
    # printf '%s\n' (not '%s') so VERSION and friends get a trailing
    # newline — POSIX text files must end with \n, and bash command
    # substitution in template_substitute strips the final newline.
    # noclobber (set -C) refuses a regular file or dangling link that
    # appeared after render_action looked. It does not cover a FIFO or
    # device swapped in during that window.
    if ! ( set -C; printf '%s\n' "$content" > "$out" ); then
      echo "gstack-extend init: cannot write $out" >&2
      return 1
    fi
    echo "  + wrote $dest"
  done
}

# scaffold_layout <target> <dry_run> <migrate>
# D2.B: mkdir canonical dirs; refuse if any canonical file already exists
# unless --migrate. In every mode, refuse first if anything init would
# create lands outside <target> (see layout_preflight). Idempotent in both
# modes (re-running on an empty dir = same result).
scaffold_layout() {
  local target="$1" dry_run="$2" migrate="$3"
  local f d
  if [ "$migrate" != "1" ] && [ -d "$target" ]; then
    for f in "${CANONICAL_FILES[@]}"; do
      if path_occupied "$target/$f"; then
        echo "gstack-extend init: refusing to scaffold over existing $f" >&2
        echo "  $target appears partially onboarded. Use --migrate to backfill only missing files." >&2
        return 1
      fi
    done
  fi
  if ! layout_preflight "$target"; then
    return 1
  fi
  if [ "$dry_run" = "1" ]; then
    for d in "${CANONICAL_DIRS[@]}"; do
      if [ ! -d "$target/$d" ]; then
        echo "  + would mkdir $target/$d"
      fi
    done
    return 0
  fi
  if ! init_mkdir "$target"; then
    return 1
  fi
  for d in "${CANONICAL_DIRS[@]}"; do
    if ! init_mkdir "$target/$d"; then
      return 1
    fi
  done
}

# layout_preflight <target>
# Every mode, dry-run included, so the preview refuses exactly when the
# real run would, before anything is written. Checks only what init would
# create: a missing canonical directory, or a canonical file whose
# render_action is create. Existing directories are left alone (mkdir -p
# on them writes nothing), so a linked docs/ that already holds every file
# still re-registers.
layout_preflight() {
  local target="$1" d f problem had_roadmap=0
  if path_occupied "$target" && [ ! -d "$target" ]; then
    echo "gstack-extend init: refusing: $target exists but is not a directory" >&2
    return 1
  fi
  for d in "${CANONICAL_DIRS[@]}"; do
    [ -d "$target/$d" ] && continue
    if [ -L "$target/$d" ] && [ ! -e "$target/$d" ]; then
      problem="$d is a dangling link"
    elif path_occupied "$target/$d"; then
      problem="$d is not a directory"
    else
      problem=$(write_problem "$target" "$target/$d")
    fi
    if [ -n "$problem" ]; then
      layout_refusal "$target" "$d" "$problem"
      return 1
    fi
  done
  if roadmap_present "$target"; then
    had_roadmap=1
  fi
  for f in "${CANONICAL_FILES[@]}"; do
    [ "$(render_action "$target" "$f" "$had_roadmap")" = "create" ] || continue
    problem=$(write_problem "$target" "$target/$f")
    if [ -n "$problem" ]; then
      layout_refusal "$target" "$f" "$problem"
      return 1
    fi
  done
}

# layout_refusal <target> <what> <problem>
layout_refusal() {
  echo "gstack-extend init: refusing to create $2: $3" >&2
  echo "  init writes only inside $1 and never through a link. Fix that path (ask before changing a link someone set up on purpose), then re-run." >&2
}

# run_audit <target>
# Spawns bin/roadmap-audit with the target as cwd and as the positional
# repo root (so a nested project is not audited at its parent git toplevel).
# Captures stdout only. Stderr flows to the caller and is not merged.
run_audit() {
  local target="$1"
  ( cd "$target" && "$REPO_ROOT/bin/roadmap-audit" "$target" ) || return $?
}

# filter_fresh_audit_stdout <raw>
# On successful fresh default init, omit sections whose single anchored
# STATUS is exactly pass. Headings match src/audit/sections.ts
# SECTION_HEADING_RE: ## UPPER_SNAKE with an optional trailing CR.
# Duplicate or conflicting STATUS lines are ambiguous and kept.
# Unsectioned text, missing STATUS, and any non-pass status stay.
# If awk fails, print the original stdout unchanged (presentation only).
filter_fresh_audit_stdout() {
  local raw="$1"
  local filtered
  if ! filtered=$(printf '%s' "$raw" | awk '
    function flush(   keep, i) {
      if (have == 0) return
      keep = 1
      if (status_n == 1 && status_val == "pass") keep = 0
      for (i = 1; i <= buf_n; i++) {
        if (keep) printf "%s", buf[i]
        delete buf[i]
      }
      buf_n = 0
      have = 0
      status_n = 0
      status_val = ""
    }
    {
      line = $0
      bare = line
      sub(/\r$/, "", bare)
      if (bare ~ /^## [A-Z_]+$/) {
        flush()
        in_sec = 1
        buf[++buf_n] = line "\n"
        have = 1
        next
      }
      if (!in_sec) {
        print
        next
      }
      buf[++buf_n] = line "\n"
      have = 1
      if (bare ~ /^STATUS:[[:space:]]*[^[:space:]]+$/) {
        val = bare
        sub(/^STATUS:[[:space:]]*/, "", val)
        status_n++
        status_val = val
      }
    }
    END { flush() }
  '); then
    printf '%s' "$raw"
    return 0
  fi
  printf '%s' "$filtered"
}

# require_jq
# Mutating init needs jq before any scaffold or registry write.
require_jq() {
  if command -v jq >/dev/null 2>&1; then
    return 0
  fi
  echo "gstack-extend init: missing dependency: jq is required to read and update the project registry." >&2
  case "$(uname -s 2>/dev/null || echo unknown)" in
    Darwin)
      echo "  Install jq with Homebrew: brew install jq" >&2
      ;;
    Linux)
      echo "  Install jq with your package manager, for example: apt-get install jq, dnf install jq, or pacman -S jq." >&2
      ;;
    *)
      echo "  Install jq and ensure the jq executable is on PATH." >&2
      ;;
  esac
  echo "  See: gstack-extend init --help" >&2
  return 1
}

# preflight_existing_registry
# Validate a registry that already exists. Do not create an absent one.
preflight_existing_registry() {
  local path
  path=$(registry_path)
  if [ -f "$path" ]; then
    registry_validate || return 1
  fi
  return 0
}

# warn_dry_run_state
# Dry-run still writes nothing. Say when registry or onboarded-state
# detection cannot be checked.
warn_dry_run_state() {
  local why="" path
  if ! command -v jq >/dev/null 2>&1; then
    why="jq is not installed"
  else
    path=$(registry_path)
    if [ -f "$path" ] && ! jq -e '.projects | type == "array"' "$path" >/dev/null 2>&1; then
      why="the existing registry is invalid ($path)"
    fi
  fi
  if [ -n "$why" ]; then
    echo "gstack-extend init: warning: registry and onboarded-state detection is unavailable because $why. Dry-run writes nothing." >&2
  fi
}

# ─── cmd_init ──────────────────────────────────────────────────────────

init_usage() {
  cat <<EOF
Usage: gstack-extend init <project> [options]

  <project>          Target directory. Created if missing. May be a path or
                     a bare name (interpreted relative to current dir).

Options:
  --name <NAME>      Display name (defaults to basename of <project>).
                     Must match [a-zA-Z0-9._-]+.
  --dry-run          Preview only. Lists each file the real run would
                     create or skip. Does not write files, does not
                     update the registry, and does not run the audit.
  --no-prompt        Headless mode; never read from stdin. Errors exit
                     non-zero loudly.
  --migrate          Backfill missing canonical files on an existing
                     project. Never overwrites an existing file.
                     Re-registers the project: replaces any entry with
                     the same path or slug and keeps its created_at (a
                     fresh init records the current time instead). A
                     slug change (e.g. a remote added since init) shows
                     as "slug: <new> (was: <old>)". Preview it first
                     with --migrate --dry-run.
  -h, --help         Show this message.

Exit codes:
  0   Init succeeded, or a dry-run preview completed. Dry-run does not
      run the audit. A completed init does not promise that every audit
      section passed; retained findings may still need attention.
      Successful fresh default init omits sections whose own STATUS is
      exactly pass. Every other section stays visible. Successful
      --migrate prints the full audit.
  1   Init failed at any step (validation, scaffold, render, register,
      audit). Rendered files are left in place on audit failure;
      registration may already have succeeded. Retry with --migrate
      after addressing the reported errors. See this help.
  2   Usage error (unknown flag, missing required arg).

Full audit output, including pass sections, without rerunning init:
  $(shell_quote "$REPO_ROOT/bin/roadmap-audit") "<absolute-project-path>"

State location: ~/.gstack-extend/projects.json
  (override via GSTACK_EXTEND_STATE_DIR for tests and direct init).
EOF
}

cmd_init() {
  local target="" name="" dry_run=0 no_prompt=0 migrate=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)    init_usage; return 0 ;;
      --dry-run)    dry_run=1;  shift ;;
      --no-prompt)  no_prompt=1; shift ;;
      --migrate)    migrate=1;  shift ;;
      --name)
        if [ -z "${2:-}" ]; then
          echo "gstack-extend init: --name requires an argument" >&2
          return 2
        fi
        name="$2"; shift 2
        ;;
      --) shift; break ;;
      -*)
        echo "gstack-extend init: unknown flag: $1" >&2
        init_usage >&2
        return 2
        ;;
      *)
        if [ -z "$target" ]; then
          target="$1"
        else
          echo "gstack-extend init: unexpected positional argument: $1" >&2
          return 2
        fi
        shift
        ;;
    esac
  done

  if [ -z "$target" ]; then
    echo "gstack-extend init: <project> argument required" >&2
    init_usage >&2
    return 2
  fi

  # Resolve target to an absolute physical path (on-disk case, see
  # physical_dir). Don't require it to exist yet.
  local target_abs
  if [ -d "$target" ]; then
    if ! physical_dir "$target"; then
      echo "gstack-extend init: cannot enter $target" >&2
      return 1
    fi
    target_abs=$PHYSICAL_DIR
  else
    local parent
    parent=$(dirname "$target")
    if [ ! -d "$parent" ]; then
      echo "gstack-extend init: parent dir of $target does not exist" >&2
      return 1
    fi
    if ! physical_dir "$parent"; then
      echo "gstack-extend init: cannot enter parent dir of $target" >&2
      return 1
    fi
    target_abs="${PHYSICAL_DIR%/}/$(basename "$target")"
  fi

  # Derive display name from --name or basename. Validate either way.
  if [ -z "$name" ]; then
    name=$(basename "$target_abs")
  fi
  if ! validate_name "$name"; then
    return 1
  fi

  # jq and an already-present registry are checked before state detection
  # so a missing dependency or corrupt file cannot be reported as "partial"
  # and cannot create a target. An absent registry stays absent until
  # registration. Dry-run keeps the no-write policy and only warns.
  if [ "$dry_run" = "1" ]; then
    warn_dry_run_state
  else
    require_jq || return 1
    preflight_existing_registry || return 1
  fi

  # Detect target state — empty / partial / onboarded — and run the flag matrix.
  local state
  state=$(detect_state "$target_abs")

  case "$state:$migrate:$dry_run" in
    onboarded:0:*)
      echo "gstack-extend init: $target_abs is already onboarded." >&2
      echo "  Project drift checks are not implemented yet (coming in a future Group)." >&2
      echo "  Use \`--migrate\` to re-register (refreshes slug, path, remote and base branch)." >&2
      return 1
      ;;
    partial:0:*)
      echo "gstack-extend init: $target_abs is partially onboarded." >&2
      echo "  Use \`--migrate\` to backfill missing canonical files." >&2
      return 1
      ;;
  esac

  # Detect language, slug, remote, base branch from the target.
  local lang slug remote base_branch
  lang=$(detect_lang "$target_abs")
  slug=$(detect_slug "$target_abs")
  remote=$(detect_remote "$target_abs")
  base_branch=$(detect_base_branch "$target_abs")

  # registry_upsert replaces every entry at this path. Name any other slug
  # it drops in the summary, so `--migrate --dry-run` previews a slug change
  # without writing anything. Dry-run without jq or with an invalid
  # registry already warned; show no label.
  local prev_slugs="" prev
  while IFS= read -r prev; do
    if [ -n "$prev" ] && [ "$prev" != "$slug" ]; then
      prev_slugs="${prev_slugs:+$prev_slugs, }$prev"
    fi
  done < <(registry_slugs_for_path "$target_abs" 2>/dev/null || true)
  local slug_label="$slug"
  if [ -n "$prev_slugs" ]; then
    slug_label="$slug (was: $prev_slugs)"
  fi

  local created_at created_at_date
  created_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  created_at_date=$(date -u +%Y-%m-%d)

  local tcb
  tcb=$(test_cmd_block "$lang")

  # Print a one-line plan summary first so the user can sanity-check.
  printf '\n'
  if [ "$dry_run" = "1" ]; then
    echo "gstack-extend init: DRY RUN — no files will be written."
  fi
  local migrate_label=""
  [ "$migrate" = "1" ] && migrate_label=" (--migrate)"
  cat <<EOF
gstack-extend init: $target_abs
  name:           $name
  slug:           $slug_label
  language:       $lang
  base_branch:    $base_branch
  remote_url:     ${remote:-(none)}
  version_scheme: 4-digit
  state:          ${state}${migrate_label}

EOF

  # Build the template var argv. Use ${test_cmd_block} as a multi-line var.
  local vars=(
    "name=$name"
    "slug=$slug"
    "created_at=$created_at"
    "created_at_date=$created_at_date"
    "test_cmd_block=$tcb"
  )

  # Scaffold (D2.B): refuse on canonical file collision or an outside write,
  # then mkdir canonical dirs.
  if ! scaffold_layout "$target_abs" "$dry_run" "$migrate"; then
    return 1
  fi

  # Render templates. (--migrate's "skip existing" behavior is enforced
  # inside render_all; no env-var toggle needed.)
  if ! render_all "$target_abs" "$dry_run" "${vars[@]}"; then
    return 1
  fi

  if [ "$dry_run" = "1" ]; then
    # In dry-run we don't write the registry or run the audit against the
    # would-be on-disk files. Audit needs real files; print a note and exit.
    echo
    echo "gstack-extend init: dry-run complete. Re-run without --dry-run to apply."
    return 0
  fi

  # Register in projects.json. Only re-registration (--migrate) keeps an
  # existing entry's created_at; a fresh init is a new project even when it
  # replaces a stale entry at this path or one with a colliding slug.
  local created_policy=fresh
  [ "$migrate" = "1" ] && created_policy=keep
  if ! registry_upsert "$slug" "$name" "$target_abs" "$remote" "$base_branch" "4-digit" "$created_at" "$created_policy"; then
    echo "gstack-extend init: registry write failed (files were rendered)" >&2
    return 1
  fi
  echo "  + registered $slug → $(registry_path)"

  # Post-render audit gate.
  echo
  echo "Running post-render audit..."
  local audit_out audit_exit
  audit_out=$(run_audit "$target_abs") && audit_exit=0 || audit_exit=$?

  local cli_abs="$SCRIPT_DIR/gstack-extend"
  local quoted_retry
  quoted_retry="$(shell_quote "$cli_abs") init --migrate --no-prompt --name $(shell_quote "$name") $(shell_quote "$target_abs")"

  if [ "$audit_exit" != "0" ]; then
    # Leave files and the registry entry. Stderr from the auditor already
    # reached the caller; replay the captured stdout here in full.
    printf '%s\n' "$audit_out" >&2
    cat >&2 <<EOF

gstack-extend init: post-render audit FAILED (exit $audit_exit).
  The audit process did not complete. Rendered files remain in place.
  Project registration already succeeded.
  After addressing the reported errors, retry with --migrate.
  See: gstack-extend init --help
  Retry: $quoted_retry
EOF
    return 1
  fi

  local shown="$audit_out"
  if [ "$state" = "empty" ] && [ "$migrate" = "0" ]; then
    shown=$(filter_fresh_audit_stdout "$audit_out")
  fi
  printf '%s\n' "$shown"

  local quoted_target
  quoted_target=$(shell_quote "$target_abs")
  cat <<EOF

gstack-extend init: SUCCESS.
  Canonical scaffolding and registration completed. Retained audit findings may need attention.
  Next 30 minutes:
    1. cd $quoted_target
    2. /project-spec       (agree on users/outcomes; finishes with /roadmap)
    3. /full-review        (weekly cadence baseline)
EOF
  return 0
}

# ─── Usage + dispatch (must be last so functions are defined) ──────────

usage() {
  cat <<'EOF'
Usage: gstack-extend <subcommand> [args...]

Subcommands:
  init <project>     Bootstrap a new gstack-extend-onboarded project.
                     `gstack-extend init --help` for flags.
  list               (coming in a future Group)
  status             (coming in a future Group)
  doctor telemetry   Local telemetry fidelity [--days N] [--json].
  quota              Capacity and consumption ledger; `quota --help`.
  doctor quota       Read-only quota diagnostics [--json].
  migrate            (coming in a future Group — see `init --migrate` for
                     per-project backfill today)

Options:
  -h, --help         Show this message.
EOF
}

cmd="${1:-}"
shift || true

# `|| exit $?` shields the dispatcher from ERR-trap noise on controlled
# non-zero returns from cmd_init (e.g., partial-onboarded refuse, bad
# --name). Without it, every UX-level error tacks on a "_die_with_line"
# stack message after the user-facing error.
case "$cmd" in
  quota)       exec python3 -B -E -s "$SCRIPT_DIR/lib/quota-cli.py" "$@" ;;
  init)        cmd_init "$@" || exit $? ;;
  doctor)
    if [ "${1:-}" = "quota" ]; then
      shift
      exec python3 -B -E -s "$SCRIPT_DIR/lib/quota-cli.py" doctor "$@"
    fi
    if [ "${1:-}" = "telemetry" ]; then
      shift
      # Conditional invocation contains failures under set -e and the ERR trap.
      # -E -s: ignore PYTHON* variables and user site-packages, as the wrapper's -I does. Not -I itself: it also
      # drops the script directory from sys.path, and the doctor imports its sibling telemetry.py.
      if ! python3 -B -E -s "$SCRIPT_DIR/lib/telemetry-doctor.py" "$@"; then
        printf '%s\n' 'Telemetry report unavailable. Check python3 and re-run ./setup. See docs/telemetry.md.'
      fi
    else
      printf '%s\n' 'Usage: gstack-extend doctor telemetry [--days N] [--json]'
    fi
    exit 0
    ;;
  list|status|migrate)
    printf 'gstack-extend %s: %s\n' "$cmd" "$COMING_SOON_MSG"
    exit 0
    ;;
  ""|-h|--help)
    usage
    exit 0
    ;;
  *)
    printf 'gstack-extend: unknown subcommand: %s\n\n' "$cmd" >&2
    usage >&2
    exit 2
    ;;
esac
