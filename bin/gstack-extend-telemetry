#!/usr/bin/env bash
# Optional telemetry: activation writes directly, completion delegates with --no-sweep.
# State and JSON handling live in bin/lib/telemetry.py. See docs/telemetry.md.
# telemetry-protocol: start-finish-v1
# (The skill blocks grep this exact line, so an older wrapper on PATH is skipped instead of
# receiving `start` calls it would misfile. Keep it in sync with PROTOCOL_MARKER in lib/telemetry.py.)
set -uo pipefail
if ! command -v python3 >/dev/null 2>&1; then
  if [ "${GSTACK_EXTEND_TELEMETRY_DEBUG:-}" = "1" ]; then
    echo 'telemetry skipped: python3 unavailable. Fix: install python3. See docs/telemetry.md.' >&2
  fi
  exit 0
fi
# Walk symlink chains (e.g. ~/.local/bin links) the way bin/gstack-extend does, without
# putting cwd on sys.path. Telemetry is optional, so a link loop is a quiet skip.
_src=$0
_hops=0
while [ -L "$_src" ]; do
  _hops=$((_hops + 1))
  if [ "$_hops" -gt 40 ]; then
    if [ "${GSTACK_EXTEND_TELEMETRY_DEBUG:-}" = "1" ]; then
      echo 'telemetry skipped: symlink loop resolving the wrapper. Fix: repair the symlink. See docs/telemetry.md.' >&2
    fi
    exit 0
  fi
  _resolved=$(readlink "$_src")
  case "$_resolved" in
    /*) _src=$_resolved ;;
    *) _src=$(dirname -- "$_src")/$_resolved ;;
  esac
done
case "$_src" in
  /*) ;;
  *) _src=$PWD/$_src ;;
esac
_py=$(dirname -- "$_src")/lib/telemetry.py
if [ ! -f "$_py" ]; then
  if [ "${GSTACK_EXTEND_TELEMETRY_DEBUG:-}" = "1" ]; then
    echo 'telemetry skipped: telemetry.py missing. Fix: re-run ./setup. See docs/telemetry.md.' >&2
  fi
  exit 0
fi
# -I keeps cwd off sys.path so a planted pathlib.py cannot run.
python3 -B -I "$_py" "$@"
exit 0
