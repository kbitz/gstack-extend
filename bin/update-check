#!/usr/bin/env bash
# gstack-extend update-check — periodic version check for all skills.
#
# Output:
#   JUST_UPGRADED <old> <new>       — marker found from recent upgrade
#   UPGRADE_AVAILABLE <old> <new>   — remote VERSION is newer than local
#   INSTALL_WARN ...                — additive local install diagnostic; not a version result
# Recognized version lines keep their order and meaning. Warning-only output is
# not a version result. Silence does not prove every installed copy is fresh:
# checks can be disabled, cached, snoozed, offline, or simply have no snapshot.
# Install warnings are collected after update_check=false and emitted after
# version lines. They are not consumed by cache, snooze, or the upgrade marker.
#
# Env overrides (for testing):
#   GSTACK_EXTEND_DIR        — override auto-detected root
#   GSTACK_EXTEND_REMOTE_URL — override remote VERSION URL
#   GSTACK_EXTEND_STATE_DIR  — override ~/.gstack-extend state directory
# extend-root-protocol: v1
# Protocol identity: skill preambles grep this line before executing anything under the root. Compatible bin changes never touch it. It changes only for an incompatible preamble↔bin contract change (update-check output, config/update-run CLI): v2 replaces v1 in the same release, and copies that were not regenerated print EXTEND_ROOT_UNVERIFIED with the setup --host auto fix.
set -euo pipefail

EXTEND_DIR="${GSTACK_EXTEND_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
STATE_DIR="${GSTACK_EXTEND_STATE_DIR:-$HOME/.gstack-extend}"
CACHE_FILE="$STATE_DIR/last-update-check"
MARKER_FILE="$STATE_DIR/just-upgraded-from"
SNOOZE_FILE="$STATE_DIR/update-snoozed"
VERSION_FILE="$EXTEND_DIR/VERSION"
REMOTE_URL="${GSTACK_EXTEND_REMOTE_URL:-https://raw.githubusercontent.com/kbitz/gstack-extend/main/VERSION}"
# NOTE: Pre-0.8.8.1 installs still check a gist at the old URL
# (gist ID 511b8a4861f7b4df3a7fedd42911c701). That gist is kept as a
# permanent bridge so those installs can discover the upgrade to this
# raw GitHub URL. Do not delete the gist.

# ─── Force flag (busts cache + snooze) ──────────────────────
if [ "${1:-}" = "--force" ]; then
  rm -f "$CACHE_FILE"
  rm -f "$SNOOZE_FILE"
fi

# ─── Step 0: Check if updates are disabled ────────────────────
_UC=$("$EXTEND_DIR/bin/config" get update_check 2>/dev/null || true)
if [ "$_UC" = "false" ]; then
  exit 0
fi

# Local install diagnostics. Armed only after the disabled-check exit so
# update_check=false stays completely silent. The EXIT trap prints warnings
# after any version line this process already wrote.
INSTALL_WARN_ARMED=0
INSTALL_WARN_BODY=""
_UC_LINES=()
_uc_home_id() {
  local phys=""
  phys=$(cd -P "$HOME" 2>/dev/null && pwd -P) || return 1
  stat -f '%d:%i' "$phys" 2>/dev/null || stat -c '%d:%i' "$phys" 2>/dev/null
}
_uc_emit() {
  local line="$1" i=0
  while [ "$i" -lt "${#_UC_LINES[@]}" ]; do
    [ "${_UC_LINES[$i]}" = "$line" ] && return 0
    i=$((i + 1))
  done
  _UC_LINES[${#_UC_LINES[@]}]="$line"
}
_uc_fix() {
  printf '%q' "$EXTEND_DIR/docs/installation.md#$1"
}
_uc_status_line() {
  local reason="$1" cause="$2" path="$3" q docs
  q=$(printf '%q' "$path")
  docs=$(_uc_fix state-recovery)
  _uc_emit "$(printf 'INSTALL_WARN reason=%s path=%s cause=%s freshness=unknown saved=kept Fix: %s' \
    "$reason" "$q" "$cause" "$docs")"
}
_uc_enum() {
  local want="$1" item
  shift
  for item in "$@"; do
    [ "$item" = "$want" ] && return 0
  done
  return 1
}
_uc_valid_fact() {
  local kind="$1" home="$2" origin="$3" oqual="$4" host="$5" logical="$6" physical="$7"
  local inode="$8" skill="$9" reason="${10}" cause="${11}" canon="${12}" variant="${13}"
  local version="${14}" sha="${15}" detect="${16}" path
  _uc_enum "$kind" fact || return 1
  _uc_enum "$oqual" this_checkout verified_checkout prior_qualified || return 1
  _uc_enum "$host" claude codex opencode cursor || return 1
  _uc_enum "$reason" shared_directory unsafe_directory cursor_unserved preserved_regular || return 1
  _uc_enum "$canon" matches_canonical differs_canonical source_unavailable not_applicable || return 1
  _uc_enum "$variant" matches_stripped differs_stripped not_applicable unavailable || return 1
  _uc_enum "$detect" binary existing_skill cursor_home explicit_host not_applicable || return 1
  case "$cause" in *[!a-z0-9_]*) return 1 ;; "") return 1 ;; esac
  case "$home" in [0-9]*:[0-9]*) ;; *) return 1 ;; esac
  case "$home" in *[!0-9:]*) return 1 ;; esac
  case "$inode" in "") ;; [0-9]*:[0-9]*) case "$inode" in *[!0-9:]*) return 1 ;; esac ;; *) return 1 ;; esac
  case "$sha" in
    "") ;;
    *)
      [ "${#sha}" -eq 64 ] || return 1
      case "$sha" in *[!0-9a-f]*) return 1 ;; esac
      ;;
  esac
  case "$version" in *[!0-9A-Za-z._+-]*) return 1 ;; "") return 1 ;; esac
  case "$skill" in "") ;; *[!A-Za-z0-9._-]*) return 1 ;; esac
  case "$origin" in /*) ;; *) return 1 ;; esac
  case "$logical" in /*) ;; *) return 1 ;; esac
  case "$physical" in "") ;; /*) ;; *) return 1 ;; esac
  case "$reason" in
    preserved_regular) [ -n "$skill" ] || return 1 ;;
    *) [ -z "$skill" ] || return 1 ;;
  esac
  if [ -n "$skill" ]; then path="$logical/$skill"; else path="$logical"; fi
  case "$path/" in
    "$HOME"/*) ;;
    *) return 1 ;;
  esac
  return 0
}
_uc_emit_fact() {
  local host="$1" skill="$2" logical="$3" reason="$4" cause="$5" canon="$6" variant="$7"
  local version="$8" oqual="$9" detect="${10}" path skill_tok q anchor docs
  if [ -n "$skill" ]; then path="$logical/$skill"; skill_tok=$skill; else path=$logical; skill_tok="-"; fi
  q=$(printf '%q' "$path")
  case "$reason" in
    unsafe_directory) anchor=troubleshooting ;;
    *) anchor=shared-directory-migration ;;
  esac
  docs=$(_uc_fix "$anchor")
  if [ -n "$skill" ]; then
    _uc_emit "$(printf 'INSTALL_WARN host=%s skill=%s path=%s reason=%s cause=%s compare=%s variant=%s observed=%s origin=%s freshness=unverified Fix: %s' \
      "$host" "$skill_tok" "$q" "$reason" "$cause" "$canon" "$variant" "$version" "$oqual" "$docs")"
  else
    _uc_emit "$(printf 'INSTALL_WARN host=%s skill=%s path=%s reason=%s cause=%s detection=%s freshness=unverified Fix: %s' \
      "$host" "$skill_tok" "$q" "$reason" "$cause" "$detect" "$docs")"
  fi
}
_uc_read_status() {
  local file="$1" home_id="$2" bytes fields i n
  if [ -L "$file" ]; then _uc_status_line status_unreadable symlink "$file"; return 0; fi
  if [ -d "$file" ]; then _uc_status_line status_unreadable directory "$file"; return 0; fi
  if [ -p "$file" ]; then _uc_status_line status_unreadable fifo "$file"; return 0; fi
  if [ ! -f "$file" ]; then _uc_status_line status_unreadable not_regular "$file"; return 0; fi
  if [ ! -r "$file" ]; then _uc_status_line status_unreadable not_readable "$file"; return 0; fi
  bytes=$(stat -f '%z' "$file" 2>/dev/null || stat -c '%s' "$file" 2>/dev/null || echo "")
  case "$bytes" in
    ""|*[!0-9]*) _uc_status_line status_unreadable not_readable "$file"; return 0 ;;
  esac
  if [ "$bytes" -gt 1048576 ]; then
    _uc_status_line status_unverified oversized "$file"
    return 0
  fi
  fields=()
  while IFS= read -r -d '' _uc_field || [ -n "${_uc_field:-}" ]; do
    fields[${#fields[@]}]="$_uc_field"
    _uc_field=""
    if [ "${#fields[@]}" -gt $((2 + 4096 * 16 + 2)) ]; then
      _uc_status_line status_unverified oversized "$file"
      return 0
    fi
  done < "$file"
  [ "${#fields[@]}" -ge 4 ] || { _uc_status_line status_unverified truncated "$file"; return 0; }
  [ "${fields[0]}" = "gstack-extend-install-status" ] || { _uc_status_line status_unverified malformed "$file"; return 0; }
  [ "${fields[1]}" = "1" ] || { _uc_status_line status_unverified unknown_schema "$file"; return 0; }
  i=2
  n=${#fields[@]}
  _UC_FACTS=0
  while [ "$i" -lt "$n" ]; do
    if [ "${fields[$i]}" = "END" ]; then
      if [ $((i + 2)) -ne "$n" ]; then _uc_status_line status_unverified extra_data "$file"; return 0; fi
      case "${fields[$((i + 1))]}" in
        ""|*[!0-9]*) _uc_status_line status_unverified count_mismatch "$file"; return 0 ;;
      esac
      [ "${fields[$((i + 1))]}" -eq "$_UC_FACTS" ] || { _uc_status_line status_unverified count_mismatch "$file"; return 0; }
      return 0
    fi
    if [ $((i + 16)) -gt "$n" ]; then _uc_status_line status_unverified truncated "$file"; return 0; fi
    if [ "$_UC_FACTS" -ge 4096 ]; then _uc_status_line status_unverified oversized "$file"; return 0; fi
    if [ "${fields[$i]}" != "fact" ]; then _uc_status_line status_unverified unknown_record "$file"; return 0; fi
    if ! _uc_valid_fact \
      "${fields[$i]}" "${fields[$((i+1))]}" "${fields[$((i+2))]}" "${fields[$((i+3))]}" \
      "${fields[$((i+4))]}" "${fields[$((i+5))]}" "${fields[$((i+6))]}" "${fields[$((i+7))]}" \
      "${fields[$((i+8))]}" "${fields[$((i+9))]}" "${fields[$((i+10))]}" "${fields[$((i+11))]}" \
      "${fields[$((i+12))]}" "${fields[$((i+13))]}" "${fields[$((i+14))]}" "${fields[$((i+15))]}"; then
      _uc_status_line status_unverified malformed "$file"
      return 0
    fi
    if [ "${fields[$((i+1))]}" = "$home_id" ]; then
      _uc_emit_fact \
        "${fields[$((i+4))]}" "${fields[$((i+8))]}" "${fields[$((i+5))]}" "${fields[$((i+9))]}" \
        "${fields[$((i+10))]}" "${fields[$((i+11))]}" "${fields[$((i+12))]}" "${fields[$((i+13))]}" \
        "${fields[$((i+3))]}" "${fields[$((i+15))]}"
    fi
    _UC_FACTS=$((_UC_FACTS + 1))
    i=$((i + 16))
  done
  _uc_status_line status_unverified truncated "$file"
}
_uc_collect() {
  local status="$STATE_DIR/install-status" lock="$STATE_DIR/install-status.lock" home_id=""
  if [ -d "$lock" ]; then
    _uc_status_line status_pending lock_held "$lock"
  fi
  if ! home_id=$(_uc_home_id); then
    _uc_status_line status_unverified home_unreadable "$status"
    return 0
  fi
  if [ -e "$status" ] || [ -L "$status" ]; then
    _uc_read_status "$status" "$home_id"
  fi
}
_uc_on_exit() {
  local i=0
  [ "${INSTALL_WARN_ARMED:-0}" -eq 1 ] || return 0
  while [ "$i" -lt "${#_UC_LINES[@]}" ]; do
    printf '%s\n' "${_UC_LINES[$i]}"
    i=$((i + 1))
  done
  return 0
}
_uc_collect || true
INSTALL_WARN_ARMED=1
trap _uc_on_exit EXIT

# ─── Semver comparison ──────────────────────────────────────
source "$EXTEND_DIR/bin/lib/semver.sh"

# ─── Snooze helper ──────────────────────────────────────────
# check_snooze <remote_version>
#   Returns 0 if snoozed (should stay quiet), 1 if not snoozed.
#
#   Snooze file format: <version> <level> <epoch>
#   Level durations: 1=24h, 2=48h, 3+=7d
#   New version resets snooze.
check_snooze() {
  local remote_ver="$1"
  if [ ! -f "$SNOOZE_FILE" ]; then
    return 1
  fi
  local snoozed_ver snoozed_level snoozed_epoch
  snoozed_ver="$(awk '{print $1}' "$SNOOZE_FILE" 2>/dev/null || true)"
  snoozed_level="$(awk '{print $2}' "$SNOOZE_FILE" 2>/dev/null || true)"
  snoozed_epoch="$(awk '{print $3}' "$SNOOZE_FILE" 2>/dev/null || true)"

  # Validate: all three fields must be non-empty
  if [ -z "$snoozed_ver" ] || [ -z "$snoozed_level" ] || [ -z "$snoozed_epoch" ]; then
    return 1
  fi

  # Validate: level and epoch must be integers
  case "$snoozed_level" in *[!0-9]*) return 1 ;; esac
  case "$snoozed_epoch" in *[!0-9]*) return 1 ;; esac

  # New version dropped? Ignore snooze.
  if [ "$snoozed_ver" != "$remote_ver" ]; then
    return 1
  fi

  # Compute snooze duration based on level
  local duration
  case "$snoozed_level" in
    1) duration=86400 ;;   # 24 hours
    2) duration=172800 ;;  # 48 hours
    *) duration=604800 ;;  # 7 days (level 3+)
  esac

  local now
  now="$(date +%s)"
  local expires=$(( snoozed_epoch + duration ))
  if [ "$now" -lt "$expires" ]; then
    return 0  # still snoozed
  fi

  return 1  # snooze expired
}

# ─── Step 1: Read local version ──────────────────────────────
LOCAL=""
if [ -f "$VERSION_FILE" ]; then
  LOCAL="$(cat "$VERSION_FILE" 2>/dev/null | tr -d '[:space:]')"
fi
if [ -z "$LOCAL" ]; then
  exit 0  # No VERSION file → skip check
fi

# ─── Step 2: Check "just upgraded" marker ─────────────────────
if [ -f "$MARKER_FILE" ]; then
  OLD="$(cat "$MARKER_FILE" 2>/dev/null | tr -d '[:space:]')"
  rm -f "$MARKER_FILE"
  rm -f "$SNOOZE_FILE"
  if [ -n "$OLD" ]; then
    echo "JUST_UPGRADED $OLD $LOCAL"
  fi
  # Don't exit — fall through to remote check in case
  # more updates landed since the upgrade
fi

# ─── Step 3: Check cache freshness ──────────────────────────
# UP_TO_DATE: 60 min TTL (detect new releases quickly)
# UPGRADE_AVAILABLE: 720 min TTL (keep nagging)
if [ -f "$CACHE_FILE" ]; then
  CACHED="$(cat "$CACHE_FILE" 2>/dev/null || true)"

  # Invalidate cache if local VERSION changed since cache was written.
  # Cache format includes the local version: "STATUS LOCAL [REMOTE]"
  CACHED_LOCAL="$(echo "$CACHED" | awk '{print $2}')"
  if [ "$CACHED_LOCAL" != "$LOCAL" ]; then
    rm -f "$CACHE_FILE"
  else
    case "$CACHED" in
      UP_TO_DATE*)        CACHE_TTL=60 ;;
      UPGRADE_AVAILABLE*) CACHE_TTL=720 ;;
      *)                  CACHE_TTL=0 ;;  # corrupt → force re-fetch
    esac

    STALE=$(find "$CACHE_FILE" -mmin +$CACHE_TTL 2>/dev/null || true)
    if [ -z "$STALE" ] && [ "$CACHE_TTL" -gt 0 ]; then
      case "$CACHED" in
        UP_TO_DATE*)
          exit 0
          ;;
        UPGRADE_AVAILABLE*)
          CACHED_NEW="$(echo "$CACHED" | awk '{print $3}')"
          if check_snooze "$CACHED_NEW"; then
            exit 0  # snoozed — stay quiet
          fi
          echo "$CACHED"
          exit 0
          ;;
      esac
    fi
  fi
fi

# ─── Step 4: Slow path — fetch remote version ────────────────
mkdir -p "$STATE_DIR"

REMOTE=""
REMOTE="$(curl -sf --max-time 5 "$REMOTE_URL" 2>/dev/null || true)"
REMOTE="$(echo "$REMOTE" | tr -d '[:space:]')"

# Validate: must look like a version number (reject HTML error pages)
if ! echo "$REMOTE" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+(\.[0-9]+)?$'; then
  # Invalid or empty response — assume up to date
  echo "UP_TO_DATE $LOCAL" > "$CACHE_FILE"
  exit 0
fi

if [ "$LOCAL" = "$REMOTE" ]; then
  echo "UP_TO_DATE $LOCAL" > "$CACHE_FILE"
  exit 0
fi

# Only prompt when remote is strictly newer (semver)
if ! version_gt "$REMOTE" "$LOCAL"; then
  # Local is ahead of remote (development) — treat as up to date
  echo "UP_TO_DATE $LOCAL" > "$CACHE_FILE"
  exit 0
fi

# Remote is newer — upgrade available
echo "UPGRADE_AVAILABLE $LOCAL $REMOTE" > "$CACHE_FILE"
if check_snooze "$REMOTE"; then
  exit 0  # snoozed — stay quiet
fi

echo "UPGRADE_AVAILABLE $LOCAL $REMOTE"
